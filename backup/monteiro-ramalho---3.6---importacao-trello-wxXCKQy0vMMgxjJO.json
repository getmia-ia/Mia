    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const telefoneMatch = $('Get por telefone').item.json;\nconst emailMatch = $json;\nconst original = $('planilha').item.json;\n\nconst telefoneFound = Object.keys(telefoneMatch).length > 0;\nconst emailFound = Object.keys(emailMatch).length > 0;\n\nlet emailFinal = original.email;\n\nif (emailFound) {\n  const mesmoLead = telefoneFound && emailMatch.telefone === telefoneMatch.telefone;\n  if (!mesmoLead) {\n    emailFinal = null; // email já pertence a outro lead, deixa em branco\n  }\n}\n\nreturn {\n  json: {\n    nome: original.nome,\n    telefone: original.telefone,\n    cargo: original.cargo,\n    email: emailFinal,\n    empresa_nome: original.empresa_nome,\n    etapa: original.etapa,\n    existe_por_telefone: telefoneFound\n  }\n};"
      },
