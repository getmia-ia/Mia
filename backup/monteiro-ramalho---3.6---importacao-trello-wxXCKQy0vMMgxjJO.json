    {
      "parameters": {
        "jsCode": "const resultado = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const dadosOriginais = $('Separador').all()[i].json;\n  const card = dadosOriginais.cards;\n\n  // aceita tanto { etapa, leads } direto quanto { output: { etapa, leads } }\n  const raw = item.json.output || item.json;\n  const etapa = raw?.etapa || 'leads_adicionados';\n  const leads = raw?.leads || [];\n\n  for (const lead of leads) {\n    resultado.push({\n      json: {\n        nome: lead.nome,\n        telefone: lead.telefone,\n        cargo: lead.cargo,\n        email: lead.email,\n        empresa_nome: card.name,\n        etapa: etapa,\n        trello_card_id: card.id\n      }\n    });\n  }\n}\n\nreturn resultado;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        256
      ],
      "id": "9f957a14-3870-422c-adcc-fd5fa3bf9ef5",
      "name": "Estruturador",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analise a descrição de um card do Trello abaixo e extraia TODOS os leads (pessoas/contatos) mencionados, mesmo que sejam vários na mesma descrição.\n\nDescrição do card:\n{{ $json.cards.desc }}\n\nNome da lista/etapa no Trello onde esse card está:\n{{ $json.etapa_trello }}\n\nEtapas válidas do CRM (escolha a que mais se aproxima do nome da lista acima):\nagendar_reuniao_frios, agendar_reuniao_quentes, aguardando_assinatura_de_nda, leads_adicionados, leads_frios, novo, contrato_assinado_e_enviado_para_operacional_compensar, supermercados, empresas_de_stand_by, leads_pedro\n\nSe nenhuma etapa válida corresponder bem ao nome da lista, use \"leads_adicionados\".\n\nPara cada lead encontrado, extraia: nome completo, telefone (formate como 55DDDNNNNNNNNN, só dígitos, sem símbolos), cargo/função, e email.\n\nSe algum campo não existir para um lead, deixe como string vazia \"\" (nunca use null). Se não houver nenhum lead identificável na descrição, ainda assim retorne a etapa, com a lista de leads vazia.\n\nResponda APENAS com o JSON puro, sem crases, sem markdown, sem a palavra \"json\" antes, e sem nenhum texto explicativo. O JSON deve ter exatamente esta estrutura na raiz (não aninhe dentro de nenhuma outra chave como \"output\"):\n{\"etapa\": \"...\", \"leads\": [...]}",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        -960,
        256
      ],
      "id": "2c51eb8b-85dc-4d12-ad0b-c20868f8ea31",
      "name": "Extrator"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        -224,
        256
      ],
      "id": "77b80625-c06f-4577-a4fd-b785109a9475",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const tabelaCompleta = $('Buscar Tabela Completa').all().map(i => i.json);\n\nconst mapaTelefone = {};\nconst mapaEmail = {};\nfor (const linha of tabelaCompleta) {\n  if (linha.telefone) mapaTelefone[linha.telefone] = linha;\n  if (linha.email) mapaEmail[linha.email] = linha;\n}\n\nfunction normalizarComparacao(valor) {\n  return (valor === undefined || valor === null) ? '' : String(valor).trim();\n}\n\n// rastreia, DENTRO deste lote, qual telefone \"ficou\" com cada email\nconst donoDoEmailNoLote = {}; // email -> telefone\n\nconst resultado = [];\n\nfor (const item of items) {\n  const original = item.json;\n  const existente = mapaTelefone[original.telefone];\n  const existePorTelefone = !!existente;\n\n  let emailFinal = original.email ? original.email.trim() : original.email;\n\n  if (emailFinal) {\n    // 1. o email ja pertence a OUTRO telefone na tabela (fora deste lote)?\n    const donoNaTabela = mapaEmail[emailFinal];\n    const ehDonoLegitimoNaTabela = existente && donoNaTabela && donoNaTabela.telefone === existente.telefone;\n\n    if (donoNaTabela && !ehDonoLegitimoNaTabela) {\n      emailFinal = null;\n    }\n  }\n\n  if (emailFinal) {\n    // 2. o email ja foi \"reservado\" por outro telefone DENTRO deste mesmo lote?\n    const donoNoLote = donoDoEmailNoLote[emailFinal];\n    if (donoNoLote && donoNoLote !== original.telefone) {\n      emailFinal = null;\n    } else {\n      donoDoEmailNoLote[emailFinal] = original.telefone;\n    }\n  }\n\n  let precisaAtualizar = true;\n  if (existePorTelefone) {\n    precisaAtualizar =\n      normalizarComparacao(existente.nome) !== normalizarComparacao(original.nome) ||\n      normalizarComparacao(existente.cargo) !== normalizarComparacao(original.cargo) ||\n      normalizarComparacao(existente.email) !== normalizarComparacao(emailFinal) ||\n      normalizarComparacao(existente.empresa_nome) !== normalizarComparacao(original.empresa_nome) ||\n      normalizarComparacao(existente.etapa) !== normalizarComparacao(original.etapa);\n  }\n\n  resultado.push({\n    json: {\n      nome: original.nome,\n      telefone: original.telefone,\n      cargo: original.cargo,\n      email: emailFinal,\n      empresa_nome: original.empresa_nome,\n      etapa: original.etapa,\n      existe_por_telefone: existePorTelefone,\n      precisa_atualizar: precisaAtualizar\n    }\n  });\n}\n\nreturn resultado;"
      },
      "type": "n8n-nodes-base.code",
