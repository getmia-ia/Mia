    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  COALESCE(m.status_plano_acao, '')            AS status_anterior,\n  COALESCE(CAST(m.produtos_tag AS CHAR), '')   AS produtos_tag,\n  COALESCE(CAST(m.dono_do_lead AS CHAR), '')   AS dono_do_lead,\n  COALESCE(CAST(m.ultimo_contato AS CHAR), '') AS ultimo_contato,\n  COALESCE(CAST(m.id AS CHAR), '')             AS mailing_id\nFROM (SELECT 1) base\nLEFT JOIN (\n  SELECT *\n  FROM mailing\n  WHERE whatsapp IN (\n    \"{{ (() => { const raw = String($('When Executed by Another Workflow').first().json.phone || ''); let p = raw.replace(/\\D/g,''); if (p.startsWith('55')) p = p.slice(2); const ddd = p.slice(0,2); const num = p.slice(2); const com9 = num.length === 8 ? '9' + num : num; return com9.length === 9 ? `(${ddd}) ${com9.slice(0,5)}-${com9.slice(5)}` : `(${ddd}) ${com9.slice(0,4)}-${com9.slice(4)}`; })() }}\",\n    \"{{ (() => { const raw = String($('When Executed by Another Workflow').first().json.phone || ''); let p = raw.replace(/\\D/g,''); if (p.startsWith('55')) p = p.slice(2); const ddd = p.slice(0,2); const num = p.slice(2); const sem9 = (num.length === 9 && num.startsWith('9')) ? num.slice(1) : num; return `(${ddd}) ${sem9.slice(0,4)}-${sem9.slice(4)}`; })() }}\"\n  )\n  ORDER BY id DESC\n  LIMIT 1\n) m ON 1 = 1;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        -960,
        544
      ],
      "id": "cc4d6d66-39e7-41e9-9730-62e5297c8bc5",
      "name": "Busca Status Atual",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "maxTries": 3,
      "credentials": {
        "mySql": {
          "id": "8ItpiHe2joMjz6qf",
          "name": "Finamob database"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Contexto do lead ANTES do update. Não decide sozinho se notifica —\n// quem decide é a trava de janela no Redis (ver nós \"Já avisei ...\").\n// Aqui só preparamos telefone normalizado e o contexto pra mensagem do grupo.\n\nconst trigger = $('When Executed by Another Workflow').first().json;\nconst atual = $('Busca Status Atual').first().json || {};\n\nconst norm = (s) => String(s ?? '').trim().toLowerCase();\n\nconst statusAnterior = norm(atual.status_anterior);\nconst statusNovo     = norm(trigger.status_plano_acao);\n\n// telefone só dígitos, com 55 — usado como chave no Redis\nconst phoneKey = String(trigger.phone ?? '').replace(/\\D/g, '');\n\nreturn [{\n  json: {\n    ...trigger,\n    phone_key: phoneKey,\n    status_anterior: atual.status_anterior ?? '',\n    mailing_id: atual.mailing_id ?? '',\n    ultimo_contato_anterior: atual.ultimo_contato ?? '',\n    mudou_status: statusAnterior !== statusNovo,\n    // usado só para o texto da mensagem: é a 1a vez ou é retorno de um lead já encaminhado?\n    ja_era_advisor:   statusAnterior === 'encaminhar advisor',\n    ja_era_parcerias: statusAnterior === 'encaminhar parcerias'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -752,
        544
      ],
      "id": "8c14ae84-0fbc-40f8-ad57-3d9ea86b4d99",
      "name": "Compara Status"
    },
