    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Registra o encaminhamento em sdr_eventos (indicador do report e do dashboard).\n-- Dedupe de 30 dias na propria query: o agente aciona a tool 'atualizar-status'\n-- a cada nova mensagem do lead, entao inserir sempre inflaria o indicador.\n-- A janela e a mesma da trava do Redis, para o numero e o aviso no grupo\n-- contarem a mesma coisa - e funciona mesmo se o Redis for limpo.\nINSERT INTO sdr_eventos (mailing_id, telefone, tipo_evento, origem, nome_app, payload)\nSELECT\n  NULLIF('{{ $('Compara Status').first().json.mailing_id }}', ''),\n  '{{ $('Compara Status').first().json.phone_key }}',\n  'encaminhado_advisor'::sdr_tipo_evento,\n  'Finamob - 7.04 - SDR Inbound - Mudança de Status',\n  'SDR-INBOUND',\n  jsonb_build_object(\n    'destino', 'advisor',\n    'status_anterior', '{{ String($('Compara Status').first().json.status_anterior || '').replace(/'/g, \"''\") }}'\n  )\nWHERE NOT EXISTS (\n  SELECT 1 FROM sdr_eventos\n  WHERE telefone = '{{ $('Compara Status').first().json.phone_key }}'\n    AND tipo_evento = 'encaminhado_advisor'::sdr_tipo_evento\n    AND created_at > now() - interval '30 days'\n);",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        704,
        224
      ],
