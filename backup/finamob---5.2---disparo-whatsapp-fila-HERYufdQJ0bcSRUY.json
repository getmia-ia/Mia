    {
      "parameters": {
        "jsCode": "// A RPC pode voltar como array em 1 item OU ja dividido. Normaliza.\nconst out=[];\nfor(const it of $input.all()){\n  const j=it.json;\n  if(Array.isArray(j)){ for(const r of j) out.push({json:r}); }\n  else if(j && Array.isArray(j.data)){ for(const r of j.data) out.push({json:r}); }\n  else if(j && j.lead_id) out.push({json:j});\n}\nreturn out;\n"
      },
      "id": "382cf3aa-f964-494e-87dc-e919d6001df3",
      "name": "Normalizar lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1568,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// Roteia origem -> phone_number_id do Meta e monta o corpo do template.\nconst MAP = {\n  'SDR-ADVISOR':     '1195821910283433',\n  'SDR-MARKETING':   '1279082001960816',\n  'SDR-REMARKETING': '1202871396233612',\n  'SDR-INBOUND':     '1292568043938721',\n};\nfunction normTel(raw){\n  let d=String(raw||'').replace(/\\D/g,'').replace(/^0+/,'');\n  if(!d) return '';\n  if(d.startsWith('55')) d=d.slice(2);\n  if(d.length===10){ const p=d.slice(2)[0]; if(['6','7','8','9'].includes(p)) d=d.slice(0,2)+'9'+d.slice(2); }\n  return '55'+d;\n}\nconst clean = v => (v==null?'':String(v)).trim();\nreturn items.map(it=>{\n  const j=it.json;\n  const pnid=MAP[j.origem_disparo];\n  const tel=normTel(j.telefone);\n  const params=[j.param_1,j.param_2,j.param_3,j.param_4,j.param_5]\n    .map(clean).filter(x=>x!=='').map(t=>({type:'text',text:t}));\n  const comps=[];\n  const temImagem=(clean(j.tipo_midia).toLowerCase()==='imagem') && !!clean(j.imagem_url);\n  if(temImagem) comps.push({type:'header',parameters:[{type:'image',image:{link:clean(j.imagem_url)}}]});\n  if(params.length) comps.push({type:'body',parameters:params});\n  const body={ messaging_product:'whatsapp', to:tel, type:'template',\n    template:{ name:j.template_name, language:{code:'pt_BR'}, ...(comps.length?{components:comps}:{}) } };\n  return { json: {\n    lead_id:j.lead_id, telefone:tel, nome:j.nome, origem_disparo:j.origem_disparo,\n    mensagem_completa:j.mensagem_completa,\n    graph_url: pnid ? ('https://graph.facebook.com/v22.0/'+pnid+'/messages') : '',\n    valido: !!pnid && !!tel && !!j.template_name,\n    motivo_invalido: !pnid ? 'origem sem phone_number_id' : (!tel ? 'telefone invalido' : (!j.template_name ? 'sem template_name' : '')),\n    body }};\n});\n"
      },
