    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update public.outbound_contatos o\nset etapa = 'sem_resposta', proximo_fup_em = null, updated_at = now()\nfrom public.outbound_campanhas c\nwhere o.campanha_id = c.id and o.etapa = 'aguardando_resposta'\n  and o.fup_count >= 2 and o.proximo_fup_em <= now()\nreturning o.id, o.campanha_id, o.id_externo, o.telefone, c.callback_url;",
        "options": {}
      },
