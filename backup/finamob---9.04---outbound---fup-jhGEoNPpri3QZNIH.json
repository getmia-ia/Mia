    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with alvo as (\n  select o.id from public.outbound_contatos o\n  where o.etapa = 'aguardando_resposta' and o.fup_count < 2 and o.proximo_fup_em <= now()\n  order by o.proximo_fup_em\n  limit 100\n  for update skip locked\n)\nupdate public.outbound_contatos o\nset proximo_fup_em = null, updated_at = now()   -- claim: outra execução não pega o mesmo\nfrom alvo, public.outbound_campanhas c\nwhere o.id = alvo.id and c.id = o.campanha_id\nreturning o.id, o.campanha_id, o.telefone, o.nome, o.variaveis, o.fup_count, c.templates,\n          case o.fup_count when 0 then 'fup1' else 'fup2' end as tipo_envio;",
        "options": {}
      },
      "id": "6b0004aa-b3e1-4024-9883-741c0d76a259",
      "name": "Claim FUPs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -688,
        448
      ],
      "credentials": {
        "postgres": {
          "id": "AnkjyUs1zUuCvnoa",
