        "operation": "executeQuery",
        "query": "update public.outbound_contatos\nset fup_count = fup_count + 1, wamid = $2, ultima_msg_em = now(),\n    proximo_fup_em = now() + interval '5 days', updated_at = now()\nwhere id = $1::uuid and etapa = 'aguardando_resposta';",
        "options": {
