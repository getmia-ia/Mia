        "jsCode": "const todas = $input.all().map(i => i.json).filter(p => p.id);\nconst alvo = todas.filter(p => p.pauta === '[TESTE Reels] Pontos que ninguém resgata');\nif (alvo.length !== 1) throw new Error('Esperava 1 Reels de teste, achei ' + alvo.length);\nreturn alvo.map(p => ({ json: { id: p.id, pauta: p.pauta } }));"
