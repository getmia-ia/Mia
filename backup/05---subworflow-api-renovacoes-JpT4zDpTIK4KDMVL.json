      "name": "qual moeda quer anunciar seu produto1",
      "executeOnce": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1d7bcf9-6cdb-4b3d-a992-bfd5c3ea66d3",
              "name": "weight_unit",
              "value": "={{ \n(() => {\n  const lista = $(\"Listar Unidade Medida1\").all().map(i => i.json);\n  const unidadeDaIA = $('When Executed by Another Workflow').first().json.unidade;\n\n  const normalizar = (valor) =>\n    String(valor || \"\")\n      .normalize(\"NFD\")\n      .replace(/[\\u0300-\\u036f]/g, \"\") // remove acentos\n      .toLowerCase()\n      .trim()                          // remove espaço no início e no fim\n      .replace(/\\s+/g, \" \")            // reduz espaços duplicados\n      .replace(/[-_/]/g, \" \")          // trata hífen, _ e / como espaço\n      .replace(/(\\d)\\s+(kg|g|t|ton|tonelada|toneladas)/g, \"$1$2\");\n\n  const buscaIA = normalizar(unidadeDaIA);\n\n  // 1. Correspondência exata normalizada\n  let encontrado = lista.find(item => {\n    const unidadeBanco = normalizar(item.translations?.pt);\n    return unidadeBanco === buscaIA;\n  });\n\n  // 2. Correspondência parcial, apenas se não houver exata\n  if (!encontrado) {\n    encontrado = lista.find(item => {\n      const unidadeBanco = normalizar(item.translations?.pt);\n      return unidadeBanco.includes(buscaIA) || buscaIA.includes(unidadeBanco);\n    });\n  }\n\n  if (!encontrado) {\n    const opcoes = lista\n      .map(item => item.translations?.pt)\n      .filter(Boolean)\n      .join(\", \");\n\n    throw new Error(\n      `Unidade '${unidadeDaIA}' não encontrada. Opções disponíveis: ${opcoes}`\n    );\n  }\n\n  return encontrado.id;\n})()\n}}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
