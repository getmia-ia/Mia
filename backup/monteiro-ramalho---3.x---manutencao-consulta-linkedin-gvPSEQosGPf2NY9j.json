      "parameters": {
        "operation": "executeQuery",
        "query": "alter table public.leads_tributario\n  add column if not exists linkedin_mensagem_em timestamptz;\n\nupdate public.leads_tributario\n   set linkedin_mensagem_em = coalesce(linkedin_mensagem_em, linkedin_conectado_em)\n where linkedin_status = 'conectado' and linkedin_mensagem_em is null;\n\nselect\n  (select string_agg(column_name, ', ' order by column_name) from information_schema.columns where table_schema = 'public' and table_name = 'leads_tributario' and column_name like 'linkedin%') as colunas_linkedin,\n  (select json_agg(x) from (select linkedin_status, count(*) n from public.leads_tributario where coalesce(linkedin_url,'') <> '' group by 1) x) as status;",
