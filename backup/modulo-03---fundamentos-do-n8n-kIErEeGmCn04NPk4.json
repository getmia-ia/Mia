    {
      "parameters": {
        "jsCode": "// Código JavaScript demonstrado na Aula 11 gerado via ChatGPT\n// Percorre uma lista de CNPJs e retorna o primeiro válido\nconst items = $input.all();\n\nlet cnpjs = [];\nif (items.length > 0) {\n  const firstJson = items[0]?.json;\n  if (Array.isArray(firstJson?.cnpjs)) {\n    cnpjs = firstJson.cnpjs;\n  } else if (Array.isArray(firstJson)) {\n    cnpjs = firstJson;\n  } else {\n    cnpjs = items.map(i => i?.json?.cnpj).filter(Boolean);\n  }\n}\n\nconst normalize = (v) => String(v ?? \"\").replace(/\\D/g, \"\");\nconst validCnpjs = cnpjs\n  .map(raw => ({ raw, digits: normalize(raw) }))\n  .filter(x => x.digits.length === 14);\n\nconst chosen = validCnpjs[0]?.raw ?? null;\n\nif (!chosen) {\n  throw new Error('Nenhum CNPJ encontrado nos formatos esperados.');\n}\n\nreturn [\n  {\n    json: {\n      firstCnpj: chosen,\n      valid: true\n    }\n  }\n];"
      },
