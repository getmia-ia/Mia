  "name": "BMS - Contratos Jurídicos - 10.02 - Disparo de Email",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "content": "### Recebe o envio do sistema\nChamado pela edge function quando o jurídico envia (ou reenvia) o documento ao cliente. Os dados já chegam prontos: destinatários, links do portal e do PDF.\n\nResponde com o retorno do Resend ({ id }) — o sistema usa esse id para acompanhar entrega, abertura e clique.",
        "height": 320,
        "width": 420,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        -112
      ],
      "id": "3a8fee58-8341-4de7-82c1-4ab2e23caf19",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "content": "### Monta e envia o e-mail\ntipo_email = \"documento\": portal + PDF anexado. tipo_email = \"formulario\": link do formulário (sem anexo).",
        "height": 320,
        "width": 1060,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -32,
        -112
      ],
      "id": "364996ef-9f65-4368-bad0-2e4cbaf93de8",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "disparo-contrato-juridico-email-bms",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -384,
        32
      ],
      "id": "dde2a146-15a9-4c2d-8b9b-1d53b86da6c3",
      "name": "Webhook",
      "webhookId": "b62fd9c6-8b79-4df1-b6ba-78501d460acd"
    },
    {
      "parameters": {
        "jsCode": "const j = $('Webhook').first().json.body;\n\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst fmtEmail = (d) => d?.nome ? `${d.nome} <${d.email}>` : d?.email;\n\nconst tipo = j.tipo_documento_label || 'Documento';\nconst empresa = j.empresa_nome || '';\nconst formulario = j.tipo_email === 'formulario';\nconst subject = formulario\n  ? `${tipo} — ${empresa}: precisamos de alguns dados`\n  : j.nova_versao\n    ? `${tipo} — ${empresa} (nova versão v${j.versao})`\n    : `${tipo} — ${empresa}`;\n\nconst saudacao = j.para?.[0]?.nome ? `Olá, ${esc(j.para[0].nome.split(' ')[0])},` : 'Olá,';\nconst intro = formulario\n  ? `Para prepararmos o <strong>${esc(tipo.toLowerCase())}</strong>, precisamos de alguns dados da empresa, do representante legal e de uma testemunha. Leva menos de 2 minutos.`\n  : j.nova_versao\n  ? `Enviamos a <strong>versão ${esc(j.versao)}</strong> do documento com os ajustes solicitados. Por favor, revise pelo portal e, se estiver tudo certo, aprove por lá.`\n  : `Segue o documento para sua revisão. Você pode ler, comentar trechos e aprovar diretamente pelo portal, sem precisar baixar nada.`;\n\nconst html = `<!doctype html>\n<html lang=\"pt-BR\">\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><title>${esc(tipo)} — ${esc(empresa)}</title></head>\n<body style=\"margin:0;padding:0;background:#F3F5F8;font-family:Arial,Helvetica,sans-serif;color:#0F2A47;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#F3F5F8;padding:32px 12px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;width:100%;background:#ffffff;border:1px solid #E3E8EF;border-radius:10px;overflow:hidden;\">\n        <tr><td style=\"background:#0F2A47;padding:24px 32px;\">\n          <div style=\"color:#ffffff;font-size:22px;font-weight:700;letter-spacing:0.06em;\">BMS</div>\n          <div style=\"margin-top:2px;color:#F2A46B;font-size:10px;letter-spacing:0.28em;text-transform:uppercase;\">Consultoria Tributária</div>\n        </td></tr>\n        <tr><td style=\"height:3px;background:#E8620E;\"></td></tr>\n\n        <tr><td style=\"padding:32px 32px 8px 32px;\">\n          <p style=\"margin:0 0 8px 0;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:#6B7A8D;\">${esc(tipo)}${j.versao ? ` · v${esc(j.versao)}` : ''}</p>\n          <h1 style=\"margin:0 0 16px 0;font-size:22px;line-height:1.3;color:#0F2A47;\">${esc(empresa)}</h1>\n          <p style=\"margin:0 0 12px 0;font-size:14px;line-height:1.6;\">${saudacao}</p>\n          <p style=\"margin:0 0 20px 0;font-size:14px;line-height:1.6;\">${intro}</p>\n        </td></tr>\n\n        ${formulario && j.formulario_url ? `<tr><td style=\"padding:4px 32px 8px 32px;text-align:center;\">\n          <a href=\"${esc(j.formulario_url)}\" style=\"display:inline-block;background:#E8620E;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-size:14px;font-weight:700;\">Preencher formulário</a>\n          <p style=\"margin:12px 0 0 0;font-size:12px;color:#6B7A8D;\">Assim que recebermos, o jurídico prepara o documento e envia para sua revisão.</p>\n        </td></tr>` : ''}\n\n        ${j.portal_url ? `<tr><td style=\"padding:4px 32px 8px 32px;text-align:center;\">\n          <a href=\"${esc(j.portal_url)}\" style=\"display:inline-block;background:#E8620E;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:8px;font-size:14px;font-weight:700;\">Revisar documento no portal</a>\n          <p style=\"margin:12px 0 0 0;font-size:12px;color:#6B7A8D;\">O PDF desta versão também segue em anexo.</p>\n        </td></tr>` : ''}\n\n        ${j.comercial?.nome ? `<tr><td style=\"padding:20px 32px 0 32px;\">\n          <p style=\"margin:0;font-size:13px;line-height:1.6;color:#3A4A5E;\">Dúvidas? Fale com <strong>${esc(j.comercial.nome)}</strong>${j.comercial.email ? ` (<a href=\"mailto:${esc(j.comercial.email)}\" style=\"color:#E8620E;\">${esc(j.comercial.email)}</a>)` : ''}.</p>\n        </td></tr>` : ''}\n\n        <tr><td style=\"padding:28px 32px 0 32px;\"><div style=\"border-top:1px solid #E3E8EF;\"></div></td></tr>\n        <tr><td style=\"padding:16px 32px 24px 32px;text-align:center;\">\n          <p style=\"margin:0 0 4px 0;font-size:12px;color:#0F2A47;font-weight:700;\">BMS Consultoria Tributária</p>\n          <p style=\"margin:0;font-size:11px;color:#8A9AAC;\">Este é um e-mail automático. O link do portal é pessoal e expira em alguns dias.</p>\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nreturn [{\n  json: {\n    from: j.email_remetente || 'BMS Consultoria Tributária <no-reply@bmsprojetos.com>',\n    to: (j.para || []).map(fmtEmail).filter(Boolean),\n    cc: (j.cc || []).map(fmtEmail).filter(Boolean),\n    subject,\n    html,\n    pdf_url: formulario ? null : (j.pdf_url || null),\n    pdf_nome: `${(j.titulo || 'documento').replace(/[\\\\/:*?\"<>|]/g, '-')}${j.versao ? ` - v${j.versao}` : ''}.pdf`,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
