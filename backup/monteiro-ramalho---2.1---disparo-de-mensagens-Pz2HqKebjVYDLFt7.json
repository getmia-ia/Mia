        "parameters": {
          "jsCode": "// Reanexa a transcrição do áudio ao payload original do webhook,\n// mantendo todos os campos originais (telefone, media_url, outbox_id, etc.)\nconst textoTranscrito = (items[0].json.text || \"\").trim();\n\nreturn [\n  {\n    json: {\n      ...$('Webhook').item.json.body,\n      transcricao_audio: textoTranscrito,\n    },\n  },\n];"
        },
