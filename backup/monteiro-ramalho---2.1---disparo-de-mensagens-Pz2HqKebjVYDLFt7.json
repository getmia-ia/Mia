        "id": "6d1da2df-59d6-4fac-8eca-cb41927662a3",
        "name": "Enviar mensagem no WhatsApp sem template",
        "retryOnFail": true,
        "credentials": {
          "httpBearerAuth": "***REMOVIDO***"
        }
      },
      {
        "parameters": {
          "jsCode": "// Dados recebidos no webhook (já processados: se for áudio, a transcrição\n// (quando bem sucedida) chega em entrada.transcricao_audio)\nconst entrada = items[0].json;\n\n// Verifica se deve usar template\nconst usarTemplate = entrada.use_template === true;\nconst isAudio = entrada.media_type === \"audio\";\n\nconst body = {\n  messaging_product: \"whatsapp\",\n  to: String(entrada.telefone),\n};\n\nif (isAudio) {\n  // --- CASO NOVO: ÁUDIO (Dentro de 24h, sem fallback de template) ---\n  body.type = \"audio\";\n  body.audio = {\n    link: entrada.media_url,\n  };\n} else if (usarTemplate) {\n  // --- CASO 1: TEMPLATE (Fora de 24h) ---\n  body.type = \"template\";\n  body.template = {\n    name: entrada.template_name,\n    language: {\n      code: entrada.template_language || \"pt_BR\",\n    },\n  };\n\n  const variaveis = entrada.template_variables || [];\n  if (variaveis.length > 0) {\n    body.template.components = [\n      {\n        type: \"body\",\n        parameters: variaveis.map((valor) => ({\n          type: \"text\",\n          text: String(valor),\n        })),\n      },\n    ];\n  }\n} else {\n  // --- CASO 2: TEXTO LIVRE (Dentro de 24h) ---\n  body.type = \"text\";\n  body.text = {\n    preview_url: false,\n    body: entrada.mensagem || \"Sem mensagem definida\",\n  };\n}\n\n// Mensagem que será salva no histórico/memória.\n// Se for áudio e a transcrição deu certo, usa o texto transcrito (bom\n// contexto para a IA). Se a transcrição falhar ou não existir, cai no\n// fallback antigo \"[áudio enviado]\".\nconst mensagem = isAudio\n  ? (entrada.transcricao_audio ? `[Áudio]: ${entrada.transcricao_audio}` : \"[áudio enviado]\")\n  : (entrada.mensagem || \"\");\n\n// Compatível com Redis Chat Memory\nconst redisMemoryMessage = JSON.stringify({\n  type: \"ai\",\n  data: {\n    content: mensagem,\n    tool_calls: [],\n    invalid_tool_calls: [],\n    additional_kwargs: {},\n    response_metadata: {}\n  }\n});\n\nreturn [\n  {\n    json: {\n      resultado: body,\n      use_template: usarTemplate,\n      mensagem_para_historico: mensagem,\n      redis_memory_message: redisMemoryMessage,\n      whatsapp_number_id: entrada.whatsapp_number_id,\n      outbox_id: entrada.outbox_id,\n      enviado_por: entrada.enviado_por,\n      nome_app: entrada.nome_app,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
