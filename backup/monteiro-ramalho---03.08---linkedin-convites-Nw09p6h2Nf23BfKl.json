    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update public.leads_tributario\n   set linkedin_status      = nullif($2, ''),\n       linkedin_provider_id = coalesce(nullif($3, ''), linkedin_provider_id),\n       linkedin_convite_em  = case when $2 = 'convidado' then now() when $2 = '' then null else linkedin_convite_em end,\n       linkedin_erro        = nullif($4, ''),\n       linkedin_mensagem_em = case when $5 = 'sim' then now() else linkedin_mensagem_em end\n where id::text = $1;",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.status, $json.provider_id || '', $json.erro || '', $json.mensagem ? 'sim' : ''] }}"
        }
      },
