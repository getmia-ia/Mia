          "jsCode": "// Limite do LinkedIn (cannot_resend_yet / 429): volta pra fila e tenta outro dia.\n// Convite já pendente: conta como convidado. Resto: erro, com o motivo salvo.\nconst l = $('Já é conexão?').item.json;\nconst raw = JSON.stringify($json).toLowerCase();\nlet status = 'erro';\nif (raw.includes('already_invited') || raw.includes('already invited') || raw.includes('pending')) status = 'convidado';\nelse if (raw.includes('cannot_resend_yet') || raw.includes('429') || raw.includes('limit') || raw.includes('too many')) status = '';\nreturn { json: { id: l.id, status, provider_id: l.provider_id, erro: JSON.stringify($json).slice(0, 500) } };"
        },
