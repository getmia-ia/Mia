      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const l = $('Extrai o perfil da URL').item.json;\nconst raw = JSON.stringify($json).toLowerCase();\nconst naoExiste = raw.includes('404') || raw.includes('not_found') || raw.includes('not found');\nconst limite = raw.includes('429') || raw.includes('limit') || raw.includes('too many');\nconst status = naoExiste ? 'sem_perfil' : (limite ? '' : 'erro');\nreturn { json: { id: l.id, status, provider_id: '', erro: JSON.stringify($json).slice(0, 500) } };"
