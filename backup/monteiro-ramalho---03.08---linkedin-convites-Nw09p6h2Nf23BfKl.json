      {
        "parameters": {
          "operation": "executeQuery",
          "query": "-- Escolhe quem o LinkedIn do Monteiro aborda hoje e já reserva cada um.\n-- Rodada agendada ($1 = true): leads que já receberam o disparo inicial e continuam nessa etapa.\n-- Rodada manual pelo editor ($1 = false): só leads de teste (origem 'teste').\n--  * Convites: até 10 por dia, quem ainda não foi verificado (status vazio).\n--  * Mensagem direta: até 10 por dia, quem já é conexão do Monteiro (marcado pela sincronização) e ainda não recebeu mensagem.\n-- Quem for descoberto como conexão na hora também recebe a mensagem direta em vez do convite.\nwith base as (\n  select l.id, l.envio_em, l.linkedin_status, l.linkedin_convite_em, l.linkedin_mensagem_em\n  from public.leads_tributario l\n  where coalesce(l.linkedin_url, '') <> ''\n    and (\n          ($1::boolean and l.envio_status = 'enviado' and l.etapa = 'disparo_inicial')\n       or (not $1::boolean and l.origem = 'teste')\n        )\n),\nconvites as (\n  select id from base\n  where linkedin_status is null\n     or (linkedin_status = 'processando' and linkedin_convite_em < now() - interval '2 hours')\n  order by envio_em desc nulls last\n  limit 10\n),\nmensagens as (\n  select id from base\n  where linkedin_status = 'ja_conectado' and linkedin_mensagem_em is null\n  order by envio_em desc nulls last\n  limit 10\n),\ncandidatos as (\n  select id from convites union select id from mensagens\n)\nupdate public.leads_tributario l\n   set linkedin_status = 'processando',\n       linkedin_convite_em = now()\n  from candidatos c\n where l.id = c.id\nreturning l.id, l.nome, l.empresa_nome, l.linkedin_url;",
          "options": {
            "queryReplacement": "={{ [$execution.mode === 'production' && $('Todo dia útil, 10h30').isExecuted] }}"
          }
        },
