        "jsCode": "// Para quem já é conexão do Monteiro: mensagem direta no LinkedIn, sem convite.\nconst primeiroNome = String($json.nome || '').trim().split(/\\s+/)[0] || '';\nconst empresa = String($json.empresa_nome || '').trim() || 'sua empresa';\nconst saudacao = primeiroNome ? `Oi ${primeiroNome}, tudo bem?` : 'Oi, tudo bem?';\nconst texto = `${saudacao} Te mandei uma mensagem no WhatsApp sobre uma oportunidade de recuperação de créditos tributários que identificamos para a ${empresa}. Se preferir, podemos falar por aqui.`;\nreturn { json: { id: $json.id, provider_id: $json.provider_id, texto } };",
