        "mode": "runOnceForEachItem",
        "jsCode": "// Pega o identificador do perfil a partir da URL (linkedin.com/in/<identificador>).\nconst url = String($json.linkedin_url || '').trim();\nconst m = url.match(/linkedin\\.com\\/in\\/([^\\/?#\\s]+)/i);\nlet slug = '';\nif (m) { try { slug = decodeURIComponent(m[1]); } catch (e) { slug = m[1]; } }\nreturn { json: { id: String($json.id), nome: $json.nome, empresa_nome: $json.empresa_nome, linkedin_url: url, slug } };"
      },
