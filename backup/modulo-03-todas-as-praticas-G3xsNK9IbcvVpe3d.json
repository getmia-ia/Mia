    },
    {
      "parameters": {
        "jsCode": "// n8n Code (JavaScript) — Run Once for All Items\n// Percorre uma lista de CNPJs (vinda em 1 item com array ou vários itens) e retorna o primeiro CNPJ encontrado.\n\nconst items = $input.all();\n\nlet cnpjs = [];\n\nif (items.length > 0) {\n  const firstJson = items[0]?.json;\n\n  if (Array.isArray(firstJson?.cnpjs)) {\n    cnpjs = firstJson.cnpjs;\n  } else if (Array.isArray(firstJson)) {\n    cnpjs = firstJson;\n  } else {\n    cnpjs = items\n      .map(i => i?.json?.cnpj)\n      .filter(Boolean);\n  }\n}\n\nconst normalize = (v) => String(v ?? \"\").replace(/\\D/g, \"\");\nconst validCnpjs = cnpjs\n  .map(raw => ({ raw, digits: normalize(raw) }))\n  .filter(x => x.digits.length === 14);\n\nconst chosen = (validCnpjs[0]?.raw) ?? (cnpjs[0] ?? null);\n\nif (!chosen) {\n  throw new Error(\"Nenhum CNPJ encontrado nos formatos esperados (ex: `cnpjs: []` ou itens com `cnpj`).\");\n}\n\nreturn [\n  {\n    json: {\n      cnpj: chosen,\n      cnpj_digits: normalize(chosen),\n      found: true,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2912,
        2000
      ],
      "id": "cbd73df9-daca-4ec9-9839-79f209f190aa",
      "name": "Validador de CNPJ (Code)",
      "onError": "continueErrorOutput"
    },
