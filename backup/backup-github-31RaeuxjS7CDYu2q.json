signments":[{"id":"d59157ba-ded2-4037-a06b-80a884e1af49","name":"commitDate","value":"={{ $json.formattedDate }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-1424,336],"id":"5133c08d-7ef0-49db-9267-f83d9fd534ae","name":"Seta a data de commit"},{"parameters":{},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[864,112],"id":"9f56d59c-7b70-4cbf-ab70-b89c8780b6f9","name":"Wait","webhookId":"006989fa-0232-4408-9611-e896b2cc7d40"},{"parameters":{},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[832,384],"id":"34898335-a3e6-4429-b365-42a372fdb21b","name":"Wait1","webhookId":"fee8d8b1-ed81-4ddd-9246-0cf8923643aa"},{"parameters":{"rule":{"interval":[{"triggerAtHour":7}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-2032,336],"id":"d789f02e-5593-4cd5-a22e-feab0f03fbd2","name":"Schedule Trigger"},{"parameters":{"resource":"messages-api","instanceName":"MIA-LOGS-2","remoteJid":"120363421402105782@g.us","messageText":"=❌ *Erro no Backup GitHub*\n📄 *Arquivo:* {{ $json.fileName }}\n⚠️ *Motivo:* {{ $json.error?.message || 'Falha na API do GitHub' }}","options_message":{}},"type":"n8n-nodes-evolution-api.evolutionApi","typeVersion":1,"position":[832,624],"id":"53be3cb4-86d8-478f-841e-1a89dea93cda","name":"Enviar texto","credentials":{"evolutionApi":{"id":"PBxKGNUnpI3LPGR3","name":"MIA-LOGS-2"}}},{"parameters":{"jsCode":"const SENSITIVE_REGEX = /(sk-[a-zA-Z0-9_\\-]{10,}|Bearer\\s+[a-zA-Z0-9\\-\\._~\\+\\/]+=*|AIza[0-9A-Za-z\\-_]{35}|ghp_[a-zA-Z0-9]{36}|xox[baprs]-[a-zA-Z0-9\\-]{10,}|eyJ[a-zA-Z0-9_\\-]+?\\.[a-zA-Z0-9_\\-]+?\\.[a-zA-Z0-9_\\-]+)/gi;\nconst SENSITIVE_KEYS = /apikey|api_key|token|secret|password|pass|authorization|auth|headers/i;\n\nreturn items.map(item => {\n  const orig = item.json;\n\n  const cleanName = (orig.name || \"workflow\")\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .toLowerCase()\n    .replace(/[^a-z0-9.\\-]+/g, \"-\")\n    .replace(/-{2,}/g, \"-\")\n    .replace(/^-+|-+$/g, \"\");\n\n  // Mantém apenas o essencial para reimportar o workflow no n8n\n  const payload = {\n    id: orig.id,\n    name: orig.name,\n    active: orig.active,\n    nodes: orig.nodes,\n    connections: orig.connections,\n    settings: orig.settings,\n    tags: orig.tags,\n    updatedAt: orig.updatedAt\n  };\n\n  // Sanitiza direto na string JSON (usa 10x menos RAM que recursão de objetos)\n  let jsonString = JSON.stringify(payload, (key, value) => {\n    if (SENSITIVE_KEYS.test(key) && typeof value === \"string\") {\n      return \"***REMOVIDO***\";\n    }\n    return value;\n  });\n\n  jsonString = jsonString.replace(SENSITIVE_REGEX, \"***REMOVIDO***\");\n\n  return {\n    json: {\n      name_clean: cleanName,\n      fileName: `${cleanName}-${orig.id}.json`,\n      updatedAt: orig.updatedAt,\n      content: jsonString\n    }\n  };\n});"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-224,336],"id":"1b1ae564-3daa-4d0a-90db-13507dae3e03","name":"Code in JavaScript"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"874c7c20-50f6-4dc2-ab13-236d48f4c7db","leftValue":"={{ $json.updatedAt }}","rightValue":"={{ $now.minus({ hours: 25 }) }}","operator":{"type":"dateTime","operation":"after"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.filter","typeVersion":2.3,"position":[-400,336],"id":"4e6cd8ea-cbac-4a33-a688-d632f271885d","name":"Filter"},{"parameters":{"jsCode":"const data = $('Seta a data de commit').first().json.commitDate;\n\n// Garante que content seja string antes de calcular os bytes\nconst totalBytes = items.reduce((acc, item) => {\n  const raw = item.json.content;\n  const str = typeof raw === 'string' ? raw : JSON.stringify(raw || '');\n  return acc + Buffer.byteLength(str, 'utf8');\n}, 0);\n\nconst totalKB = (totalBytes / 1024).toFixed(1);\n\nconst lista = items.slice(0, 15).map(item => {\n  const nome = (item.json.name_clean || item.json.name || 'workflow').replace(/-/g, ' ');\n  const horaEdit = item.json.updatedAt \n    ? new Date(item.json.updatedAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo' })\n    : '';\n  return `• ${nome} _(${horaEdit})_`;\n}).join('\\n');\n\nconst sobra = items.length > 15 ? `\\n_...e mais ${items.length - 15} fluxos_` : '';\n\nreturn [{\n  json: {\n    mensagem: `✅ *Backup GitHub Concluído*\\n📅 *Data:* ${data}\\n📦 *Fluxos:* ${items.length} (${totalKB} KB)\\n\\n📝 *Modificados nas últimas 24h:*\\n${lista}${sobra}`\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[160,80],"id":"c0355595-26ec-4d0d-a790-7c7fe5244c5b","name":"Monta Resumo"},{"parameters":{"resource":"messages-api","instanceName":"MIA-LOGS-2","remoteJid":"120363421402105782@g.us","messageText":"={{ $json.mensagem }}","options_message":{}},"type":"n8n-nodes-evolution-api.evolutionApi","typeVersion":1,"position":[336,112],"id":"dfb20ded-4674-4e40-9fae-ca2d0cdc63f9","name":"Enviar Resumo","credentials":{"evolutionApi":{"id":"PBxKGNUnpI3LPGR3","name":"MIA-LOGS-2"}}}],"connections":{"Seta data":{"main":[[{"node":"Formata a data","type":"main","index":0}]]},"Formata a data":{"main":[[{"node":"Seta a data de commit","type":"main","index":0}]]},"Recupera Workflows - N8N":{"main":[[{"node":"Filter","type":"main","index":0}]]},"Converte JSON para Binário":{"main":[[]]},"Verifica se o arquivo existe no repositório":{"main":[[{"node":"Atualiza arquivo - GitHub","type":"main","index":0}],[{"node":"Cria/Sobe arquivo - GitHub","type":"main","index":0}]]},"Atualiza arquivo - GitHub":{"main":[[{"node":"Wait","type":"main","index":0}],[{"node":"Enviar texto","type":"main","index":0}]]},"Cria/Sobe arquivo - GitHub":{"main":[[{"node":"Wait1","type":"main","index":0}],[{"node":"Enviar texto","type":"main","index":0}]]},"Combinar nomes de arquivos - GitHub":{"main":[[{"node":"Recupera Workflows - N8N","type":"main","index":0}]]},"Loo