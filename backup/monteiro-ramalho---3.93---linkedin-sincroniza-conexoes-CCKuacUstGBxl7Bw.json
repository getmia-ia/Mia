    {
      "parameters": {},
      "id": "6117d264-9d28-40a8-884b-740ab5c9ad18",
      "name": "Sincronizar agora",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cada item é uma página devolvida pela Unipile. Junta todos os perfis num mapa identificador -> id do LinkedIn.\nconst norm = (s) => { let v = String(s || '').trim().replace(/\\/+$/, ''); try { v = decodeURIComponent(v); } catch (e) {} return v.toLowerCase(); };\nconst mapa = {};\nfor (const page of $input.all()) {\n  for (const r of (page.json.items || [])) {\n    const id = norm(r.public_identifier || (String(r.public_profile_url || '').match(/\\/in\\/([^\\/?#]+)/i) || [])[1]);\n    if (!id) continue;\n    const pid = String(r.provider_id || r.member_id || '');\n    mapa[id] = pid.startsWith('ACo') ? pid : '';\n  }\n}\nreturn [{ json: { total_conexoes: Object.keys(mapa).length, mapa } }];"
      },
      "id": "04a4e7f0-f7f9-4b37-974a-70ba16e11cd0",
      "name": "Junta as conexões",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Só quem ainda não foi verificado (ou deu erro). Convidados/conectados ficam com o fluxo de aceite.\nselect id::text as id, linkedin_url\n  from public.leads_tributario\n where coalesce(linkedin_url, '') <> ''\n   and (linkedin_status is null or linkedin_status = 'erro');",
        "options": {}
      },
      "id": "c868a27b-e1f9-4d91-9e59-677b1e2978de",
      "name": "Leads com LinkedIn ainda sem status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        896,
        96
      ],
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "Hr0gqOEXHC8efR0Q",
          "name": "Monteiro - Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const { mapa, total_conexoes } = $('Junta as conexões').first().json;\nconst norm = (s) => { let v = String(s || '').trim().replace(/\\/+$/, ''); try { v = decodeURIComponent(v); } catch (e) {} return v.toLowerCase(); };\nconst achados = [];\nlet verificados = 0;\nfor (const item of $input.all()) {\n  const url = String(item.json.linkedin_url || '');\n  const m = url.match(/linkedin\\.com\\/in\\/([^\\/?#\\s]+)/i);\n  if (!m) continue;\n  verificados++;\n  const slug = norm(m[1]);\n  if (Object.prototype.hasOwnProperty.call(mapa, slug)) achados.push({ id: item.json.id, provider_id: mapa[slug] || '' });\n}\nreturn [{ json: { total_conexoes, leads_verificados: verificados, ja_conectados: achados.length, achados: JSON.stringify(achados) } }];"
      },
      "id": "081d20af-9976-49ba-a125-a2d3f8f388da",
      "name": "Cruza base x conexões",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with upd as (\n  update public.leads_tributario l\n     set linkedin_status      = 'ja_conectado',\n         linkedin_provider_id = coalesce(nullif(x.provider_id, ''), l.linkedin_provider_id),\n         linkedin_erro        = null\n    from json_to_recordset($1::json) as x(id text, provider_id text)\n   where l.id::text = x.id\n     and (l.linkedin_status is null or l.linkedin_status = 'erro')\n  returning 1\n)\nselect count(*) as marcados_agora from upd;",
        "options": {
          "queryReplacement": "={{ [$json.achados] }}"
        }
      },
      "id": "e8303ceb-c238-4582-ad63-793057095904",
      "name": "Marca quem já é conexão",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1344,
        96
      ],
