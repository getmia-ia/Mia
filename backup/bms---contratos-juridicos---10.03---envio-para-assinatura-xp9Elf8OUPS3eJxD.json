      "id": "a2661b3d-5eab-4c60-bb66-6607058b31ef",
      "name": "Aguarda processamento",
      "webhookId": "2d4ab847-ca4e-46e8-bbbc-26a6b4af4455"
    },
    {
      "parameters": {
        "jsCode": "// Para cada signatário: reaproveita o cadastro no Assinafy (mesmo e-mail) ou cria. Depois cria a\n// assinatura virtual com todos (o Assinafy manda o e-mail com o link para cada um).\nconst cfg = $('Config').first().json;\nconst req = $('Webhook').first().json.body;\nconst documentId = $('Criar Documento').first().json.data.id;\nconst headers = { 'X-Api-Key': cfg.apiKey, 'Content-Type': 'application/json' };\nconst base = 'https://api.assinafy.com.br/v1';\n\nconst ids = [];\nfor (const s of req.signatarios) {\n  const email = String(s.email).toLowerCase();\n  const busca = await this.helpers.httpRequest({\n    method: 'GET', url: `${base}/accounts/${cfg.accountId}/signers`, headers,\n    qs: { search: email, 'per-page': 100 }, json: true,\n  });\n  let signer = (busca.data || []).find((x) => String(x.email || '').toLowerCase() === email);\n  if (!signer) {\n    const criado = await this.helpers.httpRequest({\n      method: 'POST', url: `${base}/accounts/${cfg.accountId}/signers`, headers,\n      body: { full_name: s.nome, email }, json: true,\n    });\n    signer = criado.data;\n  }\n  ids.push({ email, signerId: signer.id });\n}\n\nconst assignment = await this.helpers.httpRequest({\n  method: 'POST', url: `${base}/documents/${documentId}/assignments`, headers, json: true,\n  body: {\n    method: 'virtual',\n    signerIds: ids.map((x) => x.signerId),\n    message: `${req.titulo}${req.empresa ? ` — ${req.empresa}` : ''}. Documento enviado pelo jurídico da BMS para assinatura digital.`,\n  },\n});\n\nconst urls = assignment.data?.signing_urls || [];\nreturn [{ json: {\n  assinafyDocumentoId: documentId,\n  signatarios: ids.map((x) => ({\n    ...x,\n    url: urls.find((u) => u.signer_id === x.signerId)?.url\n      || `https://app.assinafy.com.br/sign/${documentId}?email=${encodeURIComponent(x.email)}`,\n  })),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
