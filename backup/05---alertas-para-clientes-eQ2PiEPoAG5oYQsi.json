    {
      "parameters": {
        "jsCode": "function normalizarTelefone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  const ddd = digits.slice(0, 2);\n  let numero = digits.slice(2);\n\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  return `55${ddd}${numero}`;\n}\n\nconst body = $input.first().json.body;\nconst contas = body.contas || [];\n\nconst grupos = {};\n\nfor (const item of contas) {\n  const telefoneNormalizado = normalizarTelefone(item.cliente.telefone);\n  if (!telefoneNormalizado) continue;\n\n  if (!grupos[telefoneNormalizado]) {\n    grupos[telefoneNormalizado] = {\n      telefone: telefoneNormalizado,\n      nome: (item.cliente.nome || '').trim(),\n      contas: []\n    };\n  }\n\n  grupos[telefoneNormalizado].contas.push({\n    descricao: item.conta.descricao,\n    valor: item.conta.valor,\n    data_vencimento: item.conta.data_vencimento\n  });\n}\n\nreturn Object.values(grupos).map(g => ({ json: g }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        544
      ],
      "id": "842c4cd3-783b-4d7d-bea0-a403969385ee",
      "name": "Organizar e Agrupar por Cliente"
    },
