    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alertas-contas-clientes",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        1648,
        560
      ],
      "id": "4a239c30-544a-499d-a814-4063eeca3ea1",
      "name": "Webhook",
      "webhookId": "f728ad39-ae95-4f59-afe3-93e4bda2fadc"
    },
    {
      "parameters": {
        "jsCode": "function normalizarTelefone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  const ddd = digits.slice(0, 2);\n  let numero = digits.slice(2);\n\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  return `55${ddd}${numero}`;\n}\n\nconst body = $input.first().json.body;\nconst contas = body.contas || [];\n\nconst itens = contas.map(item => ({\n  tipo_conta: item.tipo_conta,\n  cliente: {\n    nome: (item.cliente.nome || '').trim(),\n    telefone: normalizarTelefone(item.cliente.telefone)\n  },\n  conta: item.conta\n})).filter(item => item.cliente.telefone);\n\nreturn itens.map(i => ({ json: i }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
        560
      ],
      "id": "8d7af8b1-3734-489c-8914-7d118c2c16b3",
      "name": "Organizar e Normalizar Dados"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        2112,
        560
      ],
      "id": "f0750626-489b-467e-8c53-f5440e863abb",
      "name": "Loop - Enviar Mensagens"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2320,
        352
      ],
      "id": "05e1a84a-9722-463c-9c94-4c186142e4d4",
      "name": "Fim do Loop"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst descricaoSegura = String(item.conta.descricao || '').replace(/\\*/g, '');\nconst valorFormatado = Number(item.conta.valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nconst dataFormatada = new Date(item.conta.data_vencimento + 'T00:00:00').toLocaleDateString('pt-BR');\n\nconst texto = `${descricaoSegura} – ${valorFormatado} (vence ${dataFormatada}).`;\n\nreturn {\n  json: {\n    telefone: item.cliente.telefone,\n    nome: item.cliente.nome,\n    template_name: \"lembrete_aviso_conta\",\n    param_0: texto,\n    mensagem_completa: `Olá! Este é o seu lembrete de hoje: ${texto} Aviso apenas informativo!`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2544,
        480
      ],
      "id": "a17168a4-57ff-4178-8010-ec5ca4028dfb",
      "name": "Montar Mensagem (Aviso)"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst valorFormatado = Number(item.conta.valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\nconst dataFormatada = new Date(item.conta.data_vencimento + 'T00:00:00').toLocaleDateString('pt-BR');\n\nreturn {\n  json: {\n    telefone: item.cliente.telefone,\n    nome: item.cliente.nome,\n    template_name: \"lembrete_conta_recorrente\",\n    param_0: item.cliente.nome,\n    param_1: item.conta.descricao,\n    param_2: valorFormatado,\n    param_3: dataFormatada,\n    mensagem_completa: `Olá ${item.cliente.nome}! Sua conta ${item.conta.descricao} no valor de ${valorFormatado} vence em ${dataFormatada}. Fique atento para evitar juros ou atraso no pagamento.`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
