      "name": "Fim do Loop"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst partes = item.contas.map(c => {\n  const descricaoSegura = String(c.descricao || '').replace(/\\*/g, '');\n  const valorFormatado = Number(c.valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\n  const dataFormatada = new Date(c.data_vencimento + 'T00:00:00').toLocaleDateString('pt-BR');\n  return `*${descricaoSegura}* – *${valorFormatado}* (vence *${dataFormatada}*)`;\n});\n\nconst listaContas = partes.join(' | ') + '.';\n\nreturn {\n  json: {\n    telefone: item.telefone,\n    nome: item.nome,\n    template_name: \"lembrete_contas_recorrentes\",\n    param_0: listaContas\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2176,
        624
      ],
      "id": "7fb52039-bfd5-4a26-9405-65f0c8e48ec8",
      "name": "Montar Mensagem Consolidada"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v22.0/928381500368600/messages",
        "authentication": "***REMOVIDO***",
        "genericAuthType": "***REMOVIDO***",
        "sendHeaders": "***REMOVIDO***",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"{{ $json.template_name }}\",\n    \"language\": { \"code\": \"pt_BR\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": {{ \n          JSON.stringify(\n            [\n              { \"type\": \"text\", \"text\": $json.param_0}\n            ].filter(p => p.text && p.text.trim() !== \"\")\n          )\n        }}\n      }\n    ]\n  }\n}\n",
        "options": {}
