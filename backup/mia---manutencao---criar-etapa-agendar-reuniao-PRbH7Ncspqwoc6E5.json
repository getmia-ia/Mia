    {
      "id": "32cbabf2-4b46-4ad9-b29a-8921d1938258",
      "name": "Planejar posições",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const NOME = 'Agendar reunião';\nconst etapas = $input.all().map(i => i.json).filter(e => e && e.id);\nif (etapas.some(e => String(e.name).trim().toLowerCase() === NOME.toLowerCase())) {\n  throw new Error('A etapa \"' + NOME + '\" já existe. Nada foi alterado.');\n}\nconst fu = etapas.find(e => String(e.name).trim().toLowerCase() === 'follow-up');\nif (!fu) throw new Error('Etapa Follow-up não encontrada. Nada foi alterado.');\nconst novaPos = Number(fu.position) + 1;\nconst mover = etapas\n  .filter(e => Number(e.position) >= novaPos)\n  .sort((a, b) => Number(b.position) - Number(a.position))\n  .map(e => ({ json: { id: e.id, nome: e.name, position: Number(e.position) + 1, nova_posicao: novaPos, org: fu.organization_id } }));\nif (!mover.length) mover.push({ json: { id: null, nome: null, position: null, nova_posicao: novaPos, org: fu.organization_id } });\nreturn mover;"
      }
    },
