    {
      "parameters": {
        "jsCode": "const hoje = new Date();\nhoje.setHours(0,0,0,0);\n\nconst inicioOntem = new Date(hoje);\ninicioOntem.setDate(hoje.getDate() - 1);\n\nconst fimProximos7 = new Date(hoje);\nfimProximos7.setDate(hoje.getDate() + 7);\n\nlet disparos = 0;\nlet disparosComResposta = 0;\nlet callsAgendados = 0;\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  // Disparos Remarketing (ontem)\n  if (Number(d.retorno_automatico) === 1 && d.dt_retorno_automatico) {\n    const dtDisparo = new Date(d.dt_retorno_automatico);\n    if (dtDisparo >= inicioOntem && dtDisparo < hoje) {\n      disparos++;\n      const temResposta = Number(d.reincidencias) > 0 ||\n        (d.ultima_reincidencia_em && String(d.ultima_reincidencia_em).trim() !== '');\n      if (temResposta) disparosComResposta++;\n    }\n  }\n\n  // Calls agendados (próximos 7 dias)\n  if (String(d.status_plano_acao || '').toLowerCase().includes('call agendado') && d.fup) {\n    const dtFup = new Date(d.fup);\n    if (dtFup >= hoje && dtFup <= fimProximos7) {\n      callsAgendados++;\n    }\n  }\n}\n\nreturn [{\n  json: {\n    disparos_remarketing: disparos,\n    disparos_com_resposta: disparosComResposta,\n    calls_agendados: callsAgendados\n  }\n}];"
      },
