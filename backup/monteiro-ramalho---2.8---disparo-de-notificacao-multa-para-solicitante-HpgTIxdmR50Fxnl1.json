    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let data = item.json.body || item.json;\n\n  const camposObrigatorios = ['tipo', 'id', 'pdf_url', 'solicitante_nome', 'solicitante_telefone'];\n\n  for (const campo of camposObrigatorios) {\n    if (data[campo] === undefined || data[campo] === null || String(data[campo]).trim() === '') {\n      throw new Error(`Campo obrigatório \"${campo}\" não informado.`);\n    }\n  }\n\n  if (data.tipo !== 'multa' && data.tipo !== 'notificacao') {\n    throw new Error('tipo deve ser \"multa\" ou \"notificacao\".');\n  }\n\n  const telefone = (raw => {\n    let t = (raw || \"\").toString().replace(/\\s+/g, \"\").replace(/\\D/g, \"\");\n    t = t.replace(/^0+/, \"\");\n    if (t.length === 8) {\n      t = \"11\" + \"9\" + t;\n    } else if (t.length === 9) {\n      t = \"11\" + t;\n    } else if (t.length === 10) {\n      t = t.replace(/^(\\d{2})(\\d{8})$/, \"$19$2\");\n    } else if (t.length === 11) {\n      t = \"55\" + t;\n    } else if (t.length === 12) {\n      t = t.slice(0, 4) + \"9\" + t.slice(4);\n    } else if (t.length > 13) {\n      t = t.slice(-13);\n    }\n    return t;\n  })(data.solicitante_telefone);\n\n  return {\n    json: {\n      tipo: data.tipo,\n      id: String(data.id),\n      pdf_url: data.pdf_url,\n      solicitante_nome: data.solicitante_nome,\n      telefone: telefone\n    }\n  };\n});"
      },
