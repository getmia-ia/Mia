    {
      "parameters": {
        "jsCode": "const nome = $('Trata os dados').first().json.solicitante_nome;\nconst telefone = $('Trata os dados').first().json.telefone;\nconst tipo = $('Trata os dados').first().json.tipo;\nconst id = $('Trata os dados').first().json.id;\nconst mediaId = $('Upload media').first().json.id;\n\nconst filename = (tipo === 'multa' ? 'MULTA' : 'NOTIFICACAO') + '_' + id.slice(0, 8) + '.pdf';\n\nconst body = {\n  messaging_product: \"whatsapp\",\n  to: telefone,\n  type: \"template\",\n  template: {\n    name: \"monteiro_condominial_documento\",\n    language: { code: \"pt_BR\" },\n    components: [\n      {\n        type: \"header\",\n        parameters: [\n          {\n            type: \"document\",\n            document: {\n              id: mediaId,\n              filename: filename\n            }\n          }\n        ]\n      },\n      {\n        type: \"body\",\n        parameters: [\n          { type: \"text\", text: nome }\n        ]\n      }\n    ]\n  }\n};\n\nreturn [{ json: { resultado: body } }];"
      },
