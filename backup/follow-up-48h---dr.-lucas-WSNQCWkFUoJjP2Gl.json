    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with ultima_mensagem as (\n  select distinct on (telefone)\n    telefone, mensagem_usuario, mensagem_agente, created_at\n  from historico_mensagens\n  order by telefone, created_at desc\n)\nselect l.*\nfrom leads_crm l\njoin ultima_mensagem um on um.telefone = l.telefone\nwhere um.mensagem_agente is not null\n  and um.created_at < now() - interval '48 hours'\n  and coalesce(l.follow_up_48h_enviado, false) = false;",
        "options": {}
      },
