      "id": "889bf127-4bfe-4cf7-b728-7d9da2a40826",
      "name": "Chamado pelo Agente",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -880,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with alvo as (\n  select o.id from public.outbound_contatos o\n  where o.telefone = $1 and o.etapa in ('aguardando_resposta','em_conversa','sem_resposta')\n  order by o.created_at desc limit 1\n),\nupd as (\n  update public.outbound_contatos o\n  set etapa = case when o.etapa = 'em_conversa' then o.etapa else 'em_conversa' end,\n      respondeu_em = coalesce(o.respondeu_em, now()),\n      proximo_fup_em = null, updated_at = now()\n  from alvo where o.id = alvo.id\n  returning o.*, (o.respondeu_em = now()) as primeira_resposta\n)\nselect upd.id, upd.campanha_id, upd.id_externo, upd.nome, upd.contexto, upd.fup_count, upd.primeira_resposta,\n       c.nome as campanha_nome, c.callback_url,\n       c.templates->'disparo'->>'texto' as texto_disparo\nfrom upd join public.outbound_campanhas c on c.id = upd.campanha_id;",
        "options": {
          "queryReplacement": "={{ $json.telefone }}"
        }
      },
      "id": "b8505132-5b12-4bbf-b635-733cfeb90f30",
      "name": "Marca em conversa",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -656,
        112
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "AnkjyUs1zUuCvnoa",
          "name": "Finamob - Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $json || {};\nconst msg = String($('Chamado pelo Agente').first().json.mensagem || '').toLowerCase().trim();\nconst optOut = /^(pare|parar|sair|stop|cancelar|descadastrar|remover)\\b|n[aã]o (quero|tenho interesse).*(mensage|contato)|para de (me )?mandar|me (tira|remove) da lista/.test(msg);\nif (!r.id) return [{ json: { is_outbound: false, opt_out: false, contexto_outbound: '' } }];\nconst etapa = ['a mensagem inicial', 'o 1º follow-up', 'o 2º follow-up'][r.fup_count] || 'um follow-up';\nreturn [{ json: {\n  is_outbound: true,\n  opt_out: optOut,\n  outbound_contato_id: r.id,\n  campanha_id: r.campanha_id,\n  id_externo: r.id_externo,\n  callback_url: r.callback_url,\n  primeira_resposta: r.primeira_resposta === true,\n  contexto_outbound: [\n    `Este lead veio de uma campanha OUTBOUND (campanha: ${r.campanha_nome || r.campanha_id}). Fomos nós que iniciamos o contato; ele não pediu atendimento.`,\n    `Ele respondeu após ${etapa}.`,\n    r.texto_disparo ? `Mensagem que enviamos: \"${r.texto_disparo}\"` : '',\n    r.contexto ? `Contexto do lead (Caccao/SaaS): ${r.contexto}` : '',\n  ].filter(Boolean).join('\\n'),\n}}];\n"
      },
      "id": "8a7ceb48-e751-4d22-aa19-445ec554f153",
      "name": "Monta contexto",
