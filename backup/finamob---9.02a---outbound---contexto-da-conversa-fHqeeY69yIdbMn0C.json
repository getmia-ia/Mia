        "query": "update public.outbound_contatos\nset etapa = 'opt_out', proximo_fup_em = null, updated_at = now()\nwhere telefone = (select telefone from public.outbound_contatos where id = $1::uuid);",
        "options": {
          "queryReplacement": "={{ $json.outbound_contato_id }}"
        }
      },
      "id": "2814ff7c-b944-4e44-a98f-4f18935eb562",
