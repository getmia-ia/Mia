        0,
        64
      ],
      "id": "64a7e55b-bc35-46a7-86ce-65de4caa0fab",
      "name": "Copy file",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleDriveOAuth2Api": "***REMOVIDO***"
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Cada campo de `dados` vira uma troca {{campo}} -> valor.\nconst { dados } = $('Organiza os dados').first().json;\n\nconst requests = Object.entries(dados ?? {}).map(([campo, valor]) => ({\n  replaceAllText: {\n    containsText: { text: `{{${campo}}}`, matchCase: true },\n    replaceText: valor == null ? '' : String(valor),\n  },\n}));\n\nreturn { json: { documentId: $input.first().json.id, requests } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        48
      ],
      "id": "7949a480-6cd1-423f-a91c-010d8b87f087",
      "name": "Monta as trocas",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://docs.googleapis.com/v1/documents/{{ $json.documentId }}:batchUpdate",
        "authentication": "***REMOVIDO***",
        "nodeCredentialType": "googleDocsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { requests: $json.requests } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        496,
