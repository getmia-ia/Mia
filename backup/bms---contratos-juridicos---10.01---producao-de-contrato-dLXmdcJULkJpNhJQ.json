        "parameters": {
          "jsCode": "// Cada campo de `dados` vira uma troca {{campo}} -> valor.\nconst { dados } = $('Organiza os dados').first().json;\n\nconst requests = Object.entries(dados ?? {}).map(([campo, valor]) => ({\n  replaceAllText: {\n    containsText: { text: `{{${campo}}}`, matchCase: true },\n    replaceText: valor == null ? '' : String(valor),\n  },\n}));\n\nreturn { json: { documentId: $input.first().json.id, requests } };"
        },
