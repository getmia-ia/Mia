    {
      "parameters": {
        "jsCode": "// Junta o cálculo com a etapa no CRM e a situação da conversa no Chatwoot\nconst calc = $('Calcular retomadas').all();\nconst leads = $('Buscar lead no CRM').all();\nconst convs = $input.all();\nconst ETAPAS_RETOMADA = ['Disparo Inicial', 'Follow-up'];\n\nconst saida = [];\ncalc.forEach((c, i) => {\n  const lead = leads[i] && leads[i].json && leads[i].json.lead;\n  const conv = (convs[i] && convs[i].json) || {};\n  const etapa = lead && lead.current_stage;\n  const humano = !!(conv.meta && conv.meta.assignee);\n  const erroConversa = !!conv.error;\n  if (!lead || !ETAPAS_RETOMADA.includes(etapa) || humano || erroConversa) return;\n  saida.push({ json: { ...c.json, lead_id: lead.id, etapa_atual: etapa } });\n});\nreturn saida;\n"
      },
