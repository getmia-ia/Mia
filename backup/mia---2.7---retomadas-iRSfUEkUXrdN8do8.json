      "name": "A cada hora"
    },
    {
      "parameters": {
        "jsCode": "// Só roda de segunda a sexta, entre 8h e 20h (horário de São Paulo)\nconst agora = new Date();\nconst sp = new Date(agora.toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));\nconst dia = sp.getDay();       // 0 = domingo, 6 = sábado\nconst hora = sp.getHours();\nconst dentro = dia >= 1 && dia <= 5 && hora >= 8 && hora < 20;\nreturn dentro ? [{ json: { agora: agora.toISOString(), horaSP: hora, diaSemana: dia } }] : [];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        272
      ],
      "id": "5a0f3b10-53da-4766-9579-989d924db231",
      "name": "Janela permitida?"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "mia-historico_mensagens",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "nome_app",
              "condition": "eq",
              "keyValue": "SDR-MIA"
            },
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ new Date(Date.now() - 15*24*60*60*1000).toISOString() }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1056,
        272
      ],
      "id": "68d23a10-48ff-48e1-892d-a95da4354c66",
      "name": "Ler histórico (15 dias)",
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "id": "FsQeUlxQ7Q6O8mbE",
          "name": "MIA - Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ===================== CONFIGURAÇÃO =====================\nconst CFG = {\n  // Só leads cuja ÚLTIMA mensagem é depois desta data entram nas retomadas.\n  // Evita mandar retomada para conversas antigas no dia em que ligar o fluxo.\n  inicio: '2026-10-23T00:00:00-03:00',\n  // Durante os testes, só estes números recebem retomadas. Lista vazia = todos.\n  numeros_liberados: [],\n  maxRetomadas: 5,\n  janelaInicio: 8,   // 8h\n  janelaFim: 20,     // 20h\n  // Se a retomada atrasar mais que isso (ex.: fluxo ficou parado), não envia mais aquela.\n  toleranciaHoras: 24\n};\n// ========================================================\n\n// Textos dos templates aprovados na Meta ({{1}} = primeiro nome)\n// Templates aprovados na Meta (conta da Mia) — {{1}} = primeiro nome do lead\nconst TEMPLATES = {\n  1: { nome: 'mia_followup_1', texto: 'Oii {{1}}! Tudo bem? Vi que você ainda não respondeu. Fica à vontade, tá tudo tranquilo! Só queria saber se ficou alguma dúvida sobre como a M[IA] pode ajudar sua empresa. 😊' },\n  2: { nome: 'mia_followup_2', texto: 'Tudo bem, {{1}}? Tem um minutinho? 😄' },\n  3: { nome: 'mia_followup_3', texto: 'Opa {{1}}!!, sabia que empresas que implementam IA reduzem até 40% do tempo em tarefas operacionais? A M[IA] já fez isso acontecer para vários negócios. Faz sentido a gente conversar 30 minutinhos sobre isso?' },\n  4: { nome: 'mia_followup_4', texto: 'Oi {{1}}! Tenho um caso aqui que acho que vai te interessar. Um dos nossos clientes automatizou o atendimento e triplicou a capacidade de resposta sem contratar ninguém. Quer entender como funciona na prática?' },\n  5: { nome: 'mia_despedida_encerramento', texto: 'Oi {{1}}! Por aqui é a Mia, da M[IA]. [mensagem de despedida]' }\n};\n\nconst TZ = 'America/Sao_Paulo';\nconst agora = new Date();\nconst inicio = new Date(CFG.inicio);\n\n// Converte uma data para \"relógio de São Paulo\" (para mexer em dia/hora)\nconst toSP = d => new Date(d.toLocaleString('en-US', { timeZone: TZ }));\nconst offsetMs = d => toSP(d).getTime() - d.getTime();         // diferença SP x UTC\n\n// Soma N dias ÚTEIS mantendo o mesmo horário e ajusta para a janela 8h–20h\nfunction proximoEnvio(ultima, n) {\n  let sp = toSP(ultima);\n  let somados = 0;\n  while (somados < n) {\n    sp.setDate(sp.getDate() + 1);\n    if (sp.getDay() !== 0 && sp.getDay() !== 6) somados++;\n  }\n  // Fora da janela (antes das 8h ou a partir das 20h): envia às 8h desse mesmo dia útil\n  const h = sp.getHours();\n  if (h < CFG.janelaInicio || h >= CFG.janelaFim) sp.setHours(CFG.janelaInicio, 0, 0, 0);\n    // Na última hora da janela (19h–19h59), adianta para 19h00, senão a rodada das 19h05 perderia o envio\n  else if (h === CFG.janelaFim - 1) sp.setHours(CFG.janelaFim - 1, 0, 0, 0);\n  return new Date(sp.getTime() - offsetMs(ultima));\n}\n\n// Agrupa o histórico por telefone\nconst porTel = {};\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (!r || !r.telefone) continue;\n  (porTel[r.telefone] = porTel[r.telefone] || []).push(r);\n}\n\nconst saida = [];\nfor (const [tel, rows] of Object.entries(porTel)) {\n  if (CFG.numeros_liberados.length && !CFG.numeros_liberados.includes(String(tel))) continue;\n  rows.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));\n\n  const doLead = rows.filter(r => !String(r.message_type || '').startsWith('retomada') && String(r.mensagem_usuario || '').trim() !== '');\n  if (!doLead.length) continue;\n  const ultimaLead = doLead[doLead.length - 1];\n  const ultimaData = new Date(ultimaLead.created_at);\n  if (ultimaData < inicio) continue;\n\n  const enviadas = rows.filter(r => String(r.message_type || '').startsWith('retomada') && new Date(r.created_at) > ultimaData).length;\n  const numero = enviadas + 1;                                  // 1..5 = retomada, 6 = perda\n  if (numero > CFG.maxRetomadas + 1) continue;                  // já tratado\n\n  const quando = proximoEnvio(ultimaData, numero);\n  const atrasoH = (agora - quando) / 3600000;\n  if (atrasoH < 0 || atrasoH > CFG.toleranciaHoras) continue;   // ainda não é hora, ou passou muito\n\n  const nomeCompleto = String(ultimaLead.nome_usuario || '').trim();\n  const primeiro = nomeCompleto.split(/\\s+/)[0] || 'tudo bem';\n  const acao = numero <= CFG.maxRetomadas ? 'retomada' : 'perda';\n  saida.push({ json: {\n    telefone: String(tel),\n    chat_id: String(rows[rows.length - 1].id_usuario || ultimaLead.id_usuario || ''),\n    primeiro_nome: primeiro,\n    nome_usuario: nomeCompleto,\n    acao,\n    template: acao === 'retomada' ? TEMPLATES[numero].nome : null,\n    texto: acao === 'retomada' ? TEMPLATES[numero].texto.replace('{{1}}', primeiro) : null,\n    numero,\n    ultima_mensagem_lead: ultimaData.toISOString(),\n    envio_previsto: quando.toISOString()\n  }});\n}\nreturn saida;\n"
      },
