    {
      "parameters": {
        "jsCode": "// ==========================================================\n// CORREÇÃO DO NONO DÍGITO\n// ==========================================================\n// O telefone chega já normalizado como 55 + DDD + 9 + 8 dígitos,\n// inclusive quando é FIXO e o 9 não deveria estar lá.\n//\n// Como distinguir, olhando o dígito logo depois do 9:\n//   9 + [6-9]xxxxxxx -> celular legítimo  -> mantém\n//   9 + [2-5]xxxxxxx -> fixo com 9 indevido -> remove o 9\n// ==========================================================\nfunction corrigirNonoDigito(raw) {\n  const d = String(raw ?? \"\").replace(/\\D/g, \"\");\n\n  // 13 dígitos = 55 + DDD + 9 dígitos. Só esse caso pode ter 9 sobrando.\n  if (d.length !== 13 || !d.startsWith(\"55\")) {\n    return { telefone: d || null, corrigido: false };\n  }\n\n  const ddd = d.slice(2, 4);\n  const local = d.slice(4); // 9 dígitos\n\n  // Não começa com 9 -> não é o caso do nono dígito, não mexe\n  if (local[0] !== \"9\") return { telefone: d, corrigido: false };\n\n  const semNove = local.slice(1); // 8 dígitos\n\n  // Prefixo de fixo -> o 9 foi colocado indevidamente\n  if (/^[2-5]/.test(semNove)) {\n    return { telefone: \"55\" + ddd + semNove, corrigido: true, tipo: \"fixo\" };\n  }\n\n  return { telefone: d, corrigido: false, tipo: \"celular\" };\n}\n\n// ==========================================================\n// Dados recebidos no webhook\n// ==========================================================\nconst entrada = items[0].json.body;\n\nconst tel = corrigirNonoDigito(entrada.telefone);\n\n// Verifica se deve usar template\nconst usarTemplate = entrada.use_template === true;\n\nconst body = {\n  messaging_product: \"whatsapp\",\n  to: tel.telefone ?? String(entrada.telefone ?? \"\"),\n};\n\nif (usarTemplate) {\n  // --- CASO 1: TEMPLATE (Fora de 24h) ---\n  body.type = \"template\";\n  body.template = {\n    name: entrada.template_name,\n    language: {\n      code: entrada.template_language || \"pt_BR\",\n    },\n  };\n\n  // Inclui os parâmetros do template, se existirem\n  if (Array.isArray(entrada.template_components) && entrada.template_components.length > 0) {\n    body.template.components = entrada.template_components;\n  }\n} else {\n  // --- CASO 2: TEXTO LIVRE (Dentro de 24h) ---\n  body.type = \"text\";\n  body.text = {\n    preview_url: false,\n    body: entrada.mensagem || \"Sem mensagem definida\",\n  };\n}\n\n// Mensagem que será salva no histórico\nconst mensagem = entrada.mensagem || \"\";\n\n// Compatível com Redis Chat Memory\nconst redisMemoryMessage = JSON.stringify({\n  type: \"ai\",\n  data: {\n    content: mensagem,\n    tool_calls: [],\n    invalid_tool_calls: [],\n    additional_kwargs: {},\n    response_metadata: {},\n  },\n});\n\nreturn [\n  {\n    json: {\n      resultado: body,\n      use_template: usarTemplate,\n      mensagem_para_historico: mensagem,\n      redis_memory_message: redisMemoryMessage,\n\n      // Telefone\n      telefone_original: entrada.telefone ?? null,\n      telefone_corrigido: tel.telefone,\n      nono_digito_removido: tel.corrigido,\n      telefone_tipo: tel.tipo ?? null,\n\n      // ID usado pela Meta para montar a URL da Graph API:\n      // https://graph.facebook.com/v18.0/{phone_number_id}/messages\n      phone_number_id: entrada.phone_number_id,\n      // ID interno (Mia) do número — NÃO usar para chamar a API da Meta\n      whatsapp_number_id: entrada.whatsapp_number_id,\n      outbox_id: entrada.outbox_id,\n      enviado_por: entrada.enviado_por,\n      nome_app: entrada.nome_app,\n      historico_id: entrada.historico_id,\n    },\n  },\n];"
      },
