  "name": "04 - Disparo de mensagens ao chegar lead novo",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "disparo-mensagens-lead-novo-eleva",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -64,
        112
      ],
      "id": "6c07c1a2-6bd3-44d6-8606-84f59ab1089e",
      "name": "Webhook",
      "webhookId": "7220eba8-1e9c-48ef-8777-1fb6b15509f1"
    },
    {
      "parameters": {
        "jsCode": "function normalizarTelefone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n\n  // Remove código do país 55 se já vier incluso\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  const ddd = digits.slice(0, 2);\n  let numero = digits.slice(2);\n\n  // Se tiver 8 dígitos, adiciona o 9 na frente\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  return `55${ddd}${numero}`;\n}\n\nconst body = $input.first().json.body;\n\nconst organizacao = body.organizacao;\n\nconst lead = {\n  ...body.lead,\n  telefone_normalizado: normalizarTelefone(body.lead.telefone)\n};\n\nconst participantes = (body.participantes || []).map(p => ({\n  ...p,\n  nome: (p.nome || '').trim(),\n  telefone_normalizado: normalizarTelefone(p.telefone)\n}));\n\nreturn [{\n  json: {\n    organizacao,\n    lead,\n    participantes\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        112
      ],
      "id": "da38780a-fd05-4e79-ab75-036752116f27",
      "name": "Organizar e Normalizar Dados"
    },
    {
      "parameters": {
        "fieldToSplitOut": "participantes",
        "include": "allOtherFields",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        384,
        112
      ],
      "id": "61c92862-2084-4879-a3cd-a80c88699c5a",
      "name": "Separar Participantes"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        608,
        112
      ],
      "id": "6ab1af7a-3184-4848-8ae9-a5243e558dc2",
      "name": "Loop - Enviar Mensagens"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        816,
        -32
      ],
      "id": "d2ac617c-ba5d-4021-9a6e-24211d2e9b18",
      "name": "Fim do Loop"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v22.0/928381500368600/messages",
        "authentication": "***REMOVIDO***",
        "genericAuthType": "***REMOVIDO***",
        "sendHeaders": "***REMOVIDO***",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"{{ $json.template_name }}\",\n    \"language\": { \"code\": \"pt_BR\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": {{ \n          JSON.stringify(\n            [\n              { \"type\": \"text\", \"text\": $json.param_0},\n              { \"type\": \"text\", \"text\": $json.param_1},\n              { \"type\": \"text\", \"text\": $json.param_2},\n              { \"type\": \"text\", \"text\": $json.param_3},\n            ].filter(p => p.text && p.text.trim() !== \"\")\n          )\n        }}\n      }\n    ]\n  }\n}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1056,
        224
      ],
      "id": "e85ce9d3-7f59-419b-a43c-484318fdde88",
      "name": "Enviar mensagem de texto",
      "retryOnFail": true,
      "credentials": {
        "httpBearerAuth": "***REMOVIDO***"
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst nomeParticipante = item.participantes.nome;\nconst telefoneParticipante = item.participantes.telefone_normalizado;\nconst nomeOrganizacao = item.organizacao.nome;\nconst nomeLead = item.lead.nome;\n\n// Remove o 55 apenas para exibição no template (mantém DDD + 9 dígitos)\nconst telefoneLeadExibicao = item.lead.telefone_normalizado.replace(/^55/, '');\n\nreturn {\n  json: {\n    telefone: telefoneParticipante,\n    template_name: \"novo_lead_organizacao\",\n    param_0: nomeParticipante,\n    param_1: nomeOrganizacao,\n    param_2: nomeLead,\n    param_3: telefoneLeadExibicao\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        224
      ],
      "id": "97580f46-1d05-43e5-ac37-a4ba2754b042",
      "name": "Montar Parâmetros para Template"
    },
