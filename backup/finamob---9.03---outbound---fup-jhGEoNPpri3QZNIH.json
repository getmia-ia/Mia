    {
      "parameters": {
        "jsCode": "\n// Monta o payload do template para a Cloud API + texto renderizado para o histórico\nreturn $input.all().map(({ json: c }) => {\n  const tipo = c.tipo_envio;                      // 'disparo' | 'fup1' | 'fup2'\n  const tpl = (c.templates || {})[tipo] || {};\n  const vars = ((c.variaveis || {})[tipo] || (c.variaveis || {}).disparo || [c.nome || '']).map(v => String(v ?? ''));\n  const qtd = (String(tpl.texto || '').match(/\\{\\{\\s*\\d+\\s*\\}\\}/g) || []).length;\n  const params = vars.slice(0, qtd);\n  while (params.length < qtd) params.push(c.nome || '');\n  const components = params.length\n    ? [{ type: 'body', parameters: params.map(text => ({ type: 'text', text })) }]\n    : [];\n  if (tpl.header_image_url) {\n    components.unshift({ type: 'header', parameters: [{ type: 'image', image: { link: tpl.header_image_url } }] });\n  }\n  const texto = String(tpl.texto || '').replace(/\\{\\{\\s*(\\d+)\\s*\\}\\}/g, (_m, i) => params[Number(i) - 1] ?? '');\n  return { json: {\n    ...c,\n    template_name: tpl.name,\n    texto_renderizado: texto,\n    meta_body: {\n      messaging_product: 'whatsapp',\n      to: c.telefone,\n      type: 'template',\n      template: { name: tpl.name, language: { code: tpl.language || 'pt_BR' }, components },\n    },\n  }};\n});\n"
      },
