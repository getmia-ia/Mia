    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Claim com \"lease\" de 1h: se a execução cair no meio, o contato volta a ser pego depois\n-- (em vez de ficar sem próximo FUP para sempre). skip locked evita duas execuções no mesmo contato.\nwith alvo as (\n  select o.id from public.outbound_contatos o\n  join public.outbound_campanhas c on c.id = o.campanha_id and c.status <> 'cancelada'\n  where o.etapa = 'aguardando_resposta' and o.fup_count < 2 and o.proximo_fup_em <= now()\n  order by o.proximo_fup_em\n  limit 100\n  for update of o skip locked\n)\nupdate public.outbound_contatos o\nset proximo_fup_em = now() + interval '1 hour', updated_at = now()\nfrom alvo, public.outbound_campanhas c\nwhere o.id = alvo.id and c.id = o.campanha_id\nreturning o.id, o.campanha_id, o.telefone, o.nome, o.variaveis, o.fup_count, o.mailing_id, c.templates,\n          case o.fup_count when 0 then 'fup1' else 'fup2' end as tipo_envio;",
        "options": {}
      },
