    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Só avança se o lead não respondeu enquanto o FUP saía.\nupdate public.outbound_contatos\nset fup_count = fup_count + 1, wamid = $2, erro = null, ultima_msg_em = now(),\n    -- fup_count aqui é o valor ANTES do envio: 0 = acabou de sair o FUP 1, 1 = acabou de sair o FUP 2\n    proximo_fup_em = now() + make_interval(days => (\n      select case when outbound_contatos.fup_count = 0 then c.dias_fup2 else c.dias_encerramento end\n      from public.outbound_campanhas c where c.id = outbound_contatos.campanha_id)),\n    updated_at = now()\nwhere id = $1::uuid and etapa = 'aguardando_resposta'\nreturning proximo_fup_em;",
        "options": {
          "queryReplacement": "={{ [$('Monta template').item.json.id, $json.messages?.[0]?.id ?? null] }}"
        }
