    {
      "id": "5e6a29ab-f7b4-4674-9726-f4fc7367f8f4",
      "name": "Preparar temas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const arq = $('Montar texto').first().json;\nconst validos = new Set(arq.ids);\nconst out = $input.first().json.output || {};\nconst pg = (arr) => '{' + (arr || []).map(k => '\"' + String(k).replace(/[\"\\\\{}]/g, '').trim() + '\"').join(',') + '}';\n// Descarta trecho com id que não existe no arquivo: o modelo não pode inventar fonte.\nconst temas = (out.temas || []).map(t => ({\n  file_id: arq.file_id, file_name: arq.file_name, folder_path: arq.folder_path,\n  titulo: String(t.titulo || '').slice(0, 200), resumo: String(t.resumo || ''),\n  palavras_pg: pg(t.palavras_chave),\n  trechos_json: JSON.stringify((t.trechos || []).filter(x => validos.has(Number(x.chunk_id))).map(x => ({ chunk_id: Number(x.chunk_id), citacao: String(x.citacao || '') }))),\n})).filter(t => t.titulo);\nreturn [{ json: { file_id: arq.file_id, file_name: arq.file_name, folder_path: arq.folder_path, trechos: arq.trechos, tipo_fonte: out.tipo_fonte || '', total: temas.length, temas } }];"
      }
    },
