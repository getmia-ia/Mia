      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const evento = $('Identifica documento').first().json;\nconst d = $input.first().json.data || evento.objeto || {};\nconst signers = d.assignment?.signers || [];\nreturn [{ json: {\n  assinafyDocumentoId: d.id,\n  evento: evento.evento,\n  status: d.status,\n  signatarios: signers.map((s) => ({ email: s.email, signerId: s.id, completed: !!s.completed })),\n  recusadoPor: d.declined_by?.email || d.declined_by?.id || (typeof d.declined_by === 'string' ? d.declined_by : null),\n  motivoRecusa: d.decline_reason || null,\n} }];"
      },
