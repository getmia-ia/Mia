      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const evento = $('Webhook Assinafy').first().json.body;\nconst d = $input.first().json.data || evento.object || {};\nconst signers = d.assignment?.signers || [];\nreturn [{ json: {\n  assinafyDocumentoId: d.id,\n  evento: evento.event,\n  status: d.status,\n  signatarios: signers.map((s) => ({ email: s.email, signerId: s.id, completed: !!s.completed })),\n  recusadoPor: d.declined_by?.email || d.declined_by?.id || (typeof d.declined_by === 'string' ? d.declined_by : null),\n  motivoRecusa: d.decline_reason || null,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
