    {
      "parameters": {
        "jsCode": "const leadEmail = ($('trigger').first().json.email || '').trim().toLowerCase();\nconst now = new Date();\n\nconst matches = items.filter(item => {\n  const event = item.json;\n  if (event.attendees && Array.isArray(event.attendees)) {\n    return event.attendees.some(attendee =>\n      attendee.email && attendee.email.trim().toLowerCase() === leadEmail\n    );\n  }\n  return false;\n});\n\nconst futureMeetings = matches\n  .filter(item => item.json.start?.dateTime && new Date(item.json.start.dateTime) > now)\n  .sort((a, b) => new Date(a.json.start.dateTime) - new Date(b.json.start.dateTime));\n\nif (!futureMeetings.length) {\n  return [{ json: { found: false } }];\n}\n\nconst evento = futureMeetings[0].json;\n\nreturn [{\n  json: {\n    found: true,\n    eventId: evento.id,\n    attendeesAtuais: evento.attendees || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        160
      ],
      "id": "0a4aaee3-3f54-4540-b31f-c932a7467511",
      "name": "Identificar Reunião para Adicionar Convidado"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "325a0641-9aab-434d-8649-7e60d4638112",
              "name": "response",
              "value": "Não encontrei nenhuma reunião futura marcada para esse e-mail, então não consegui adicionar o convidado",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": "={{ false }}",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1264,
        224
      ],
      "id": "b0a74d2e-f333-4dbb-9d5d-d05e22f13264",
      "name": "Resposta: Reunião Não Encontrada"
    },
    {
      "parameters": {
        "jsCode": "const evento = $input.first().json;\n\nconst trigger = $('trigger').first().json;\n\nconst novosConvidados = trigger.emailConvidado\n  ? [{\n      email: trigger.emailConvidado.trim().toLowerCase(),\n      displayName: trigger.nomeConvidado || \"\"\n    }]\n  : [];\n\nconst existentes = (evento.attendeesAtuais || []).map(a => ({\n  email: (a.email || \"\").trim().toLowerCase(),\n  displayName: a.displayName || \"\"\n}));\n\nconst combinados = [...existentes];\nfor (const novo of novosConvidados) {\n  if (!combinados.some(a => a.email === novo.email)) {\n    combinados.push(novo);\n  }\n}\n\nreturn [{\n  json: {\n    eventId: evento.eventId,\n    attendeesFinal: combinados,\n    nomesAdicionados: novosConvidados.map(c => c.displayName || c.email).join(', ')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        80
      ],
