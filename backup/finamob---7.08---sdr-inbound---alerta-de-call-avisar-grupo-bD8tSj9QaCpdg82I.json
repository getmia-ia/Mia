    {
      "parameters": {
        "jsCode": "// Normaliza telefone e monta o texto do alerta.\nconst body = $json.body ?? $json;\n\nfunction normaliza(raw) {\n  let t = String(raw ?? '').replace(/\\D/g, '');\n  if (!t) return '';\n  if (t.startsWith('55')) t = t.slice(2);\n  if (t.length === 10) t = t.slice(0, 2) + '9' + t.slice(2);\n  return '55' + t;\n}\n\nconst phone = normaliza(body.phone);\nif (!phone || phone.length < 12) {\n  throw new Error('phone inválido recebido pela tool alerta_call: ' + body.phone);\n}\n\nconst MOTIVOS = {\n  na_call:   'Lead está na sala e ninguém entrou',\n  esperando: 'Lead está na sala de espera aguardando ser aceito',\n  sem_acesso:'Lead não está conseguindo acessar o link da reunião'\n};\n\nconst motivo = MOTIVOS[body.motivo] ? body.motivo : 'na_call';\nconst nome = (body.nome || '').trim() || 'Lead sem nome no cadastro';\nconst detalhe = (body.detalhe || '').trim();\n\nconst agora = new Date().toLocaleTimeString('pt-BR', {\n  timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit'\n});\n\nconst texto =\n  '🔴 *CALL AGORA - AÇÃO IMEDIATA*\\n' +\n  MOTIVOS[motivo] + '\\n\\n' +\n  '*Lead:* ' + nome + '\\n' +\n  '*WhatsApp:* +' + phone + '\\n' +\n  (body.email ? '*E-mail:* ' + body.email + '\\n' : '') +\n  (detalhe ? '*O que ele disse:* ' + detalhe + '\\n' : '') +\n  '*Horário do aviso:* ' + agora + '\\n\\n' +\n  'Origem: SDR Inbound';\n\nreturn [{ json: { phone, nome, motivo, detalhe, texto, redis_key: 'notif_call:' + phone } }];"
      },
