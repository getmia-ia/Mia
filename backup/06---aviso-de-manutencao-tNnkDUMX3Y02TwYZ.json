    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  v.conta_nome as nome,\n  v.conta_telefone as telefone\nfrom v_historico_conversas_lista v\nwhere v.user_id not in (\n  '48864b57-5428-46f1-9023-9e70ccc3e72f', -- Tywin Lannister\n  'b07b75bd-cc08-4d20-b392-5c502bedba91'  -- Julius Rock\n)\norder by v.conta_nome;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        96,
        224
      ],
      "id": "8b06ccfd-a658-4704-9f2e-68ea2599daf8",
      "name": "Buscar Clientes Ativos",
      "credentials": {
        "postgres": {
          "id": "769u9DNAemYPOCzL",
          "name": "ELEVA - Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function normalizarTelefone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  const ddd = digits.slice(0, 2);\n  let numero = digits.slice(2);\n\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  return `55${ddd}${numero}`;\n}\n\nconst itens = $input.all().map(i => i.json);\n\nconst vistos = new Set();\nconst clientes = itens\n  .map(c => ({ nome: (c.nome || '').trim(), telefone: normalizarTelefone(c.telefone) }))\n  .filter(c => c.telefone && !vistos.has(c.telefone) && vistos.add(c.telefone));\n\nreturn clientes.map(c => ({ json: c }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        224
      ],
      "id": "2a4fce11-0be0-4608-9e53-2a1147d57ae0",
      "name": "Organizar e Normalizar Dados"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        544,
        224
      ],
      "id": "6bd71bf9-4cef-4806-a737-0f56faf59348",
      "name": "Loop - Enviar Mensagens"
    },
