        "jsCode": "\n// Loop com batchSize = 1 -> o item atual do loop e o request correspondente\nconst req = $('Loop de Midia').first().json;\nconst res = $json || {};\nconst criado = !!res.id;\n\nlet erro = '';\nif (!criado) {\n  if (res.error) erro = res.error.error_user_msg || res.error.error_user_title || res.error.message || JSON.stringify(res.error);\n  else erro = JSON.stringify(res).slice(0, 500);\n}\n\nreturn {\n  json: {\n    nome: req.nome,\n    language: req.language,\n    id_antigo: req.id_antigo,\n    id_novo: res.id || '',\n    status: criado ? 'CRIADO' : 'ERRO',\n    categoria_atribuida: res.category || '',\n    status_meta: res.status || '',\n    erro: erro,\n    executado_em: new Date().toISOString(),\n    handle_novo: req.handle_novo || '',\n  }\n};\n"
