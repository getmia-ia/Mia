    {
      "parameters": {
        "jsCode": "\n// Junta o upload_session_id (json) com o binario baixado (que o node HTTP anterior nao propaga)\nconst src = $('Preparar Upload').first();\nconst sessionId = $json.id;   // formato: upload:MTk...\nif (!sessionId) throw new Error('A Meta nao devolveu upload session id: ' + JSON.stringify($json).slice(0, 300));\n\nreturn [{\n  json: { upload_session: sessionId, file_length: src.json.file_length, file_type: src.json.file_type },\n  binary: src.binary,\n}];\n"
      },
