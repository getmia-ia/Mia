        -1168,
        1520
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Le o binario baixado e descobre tamanho + mime type (o /uploads exige os dois)\nconst MIME = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', mp4: 'video/mp4', pdf: 'application/pdf', webp: 'image/webp' };\nconst ctx = $('Loop de Midia').first().json;\nconst items = $input.all();\nconst out = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const bin = items[i].binary && items[i].binary.data;\n  if (!bin) {\n    throw new Error('Nao foi possivel baixar a midia de ' + ctx.nome + ' (URL do scontent provavelmente expirou): ' + ctx.media_url);\n  }\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n\n  const url = String(ctx.media_url || '');\n  const ext = (url.split('?')[0].split('.').pop() || '').toLowerCase();\n  let mime = bin.mimeType && bin.mimeType !== 'application/octet-stream' ? bin.mimeType : (MIME[ext] || 'image/jpeg');\n  if (mime === 'image/jpg') mime = 'image/jpeg';\n\n  out.push({\n    json: { nome: ctx.nome, file_length: buf.length, file_type: mime, tamanho_kb: Math.round(buf.length / 1024) },\n    binary: items[i].binary,\n  });\n}\n\nreturn out;\n"
      },
