    {
      "parameters": {
        "jsCode": "\n// Monta o payload da Meta a partir das colunas da planilha.\n// Descarta: id, status, sub_category (nao sao aceitos na criacao)\n// Templates com header de midia vao para a trilha de re-upload (_midia = true)\nconst MEDIA = ['IMAGE', 'VIDEO', 'DOCUMENT'];\nconst out = [];\nconst seen = new Set();\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  const name = String(r.name || '').trim();\n  if (!name) continue;\n  const language = String(r.language || 'pt_BR').trim();\n\n  const key = name + '|' + language;\n  if (seen.has(key)) continue;   // evita nome+idioma duplicado (ex: hello_world nas 2 abas)\n  seen.add(key);\n\n  let comps = [];\n  try {\n    comps = typeof r.components_json === 'string'\n      ? JSON.parse(r.components_json)\n      : (r.components_json || []);\n  } catch (e) {\n    comps = [];\n  }\n\n  let headerFormat = String(r.header_format || '').toUpperCase();\n  const hComp = comps.find(c => String(c.type).toUpperCase() === 'HEADER');\n  if (!headerFormat && hComp) headerFormat = String(hComp.format || '').toUpperCase();\n  const temMidia = MEDIA.includes(headerFormat);\n\n  // URL da midia salva pelo fluxo anterior\n  let mediaUrl = r.header_media_url || null;\n  if (temMidia && !mediaUrl && hComp && hComp.example && hComp.example.header_handle) {\n    mediaUrl = hComp.example.header_handle[0];\n  }\n\n  const clean = [];\n  for (const c of comps) {\n    const t = String(c.type || '').toUpperCase();\n\n    if (t === 'HEADER') {\n      const fmt = String(c.format || '').toUpperCase();\n      if (MEDIA.includes(fmt)) {\n        // placeholder: o header_handle real e injetado depois do upload\n        clean.push({ type: 'HEADER', format: fmt, example: { header_handle: ['__HANDLE__'] } });\n      } else {\n        const h = { type: 'HEADER', format: 'TEXT', text: c.text };\n        if (c.example) h.example = c.example;\n        clean.push(h);\n      }\n\n    } else if (t === 'BODY') {\n      const b = { type: 'BODY', text: c.text };\n      const vars = [...new Set(String(c.text || '').match(/\\{\\{\\s*[\\w.]+\\s*\\}\\}/g) || [])];\n      if (c.example && (c.example.body_text || c.example.body_text_named_params)) {\n        b.example = c.example;\n      } else if (vars.length) {\n        // Meta exige exemplo quando ha variavel no corpo\n        b.example = { body_text: [vars.map((_, i) => 'exemplo' + (i + 1))] };\n      }\n      clean.push(b);\n\n    } else if (t === 'FOOTER') {\n      clean.push({ type: 'FOOTER', text: c.text });\n\n    } else if (t === 'BUTTONS') {\n      const btns = (c.buttons || []).map(b => {\n        const bt = { type: b.type, text: b.text };\n        if (b.type === 'URL') { bt.url = b.url; if (b.example) bt.example = b.example; }\n        if (b.type === 'PHONE_NUMBER') bt.phone_number = b.phone_number;\n        if (b.type === 'COPY_CODE' && b.example) bt.example = b.example;\n        if (b.type === 'FLOW') { bt.flow_id = b.flow_id; bt.flow_action = b.flow_action; bt.navigate_screen = b.navigate_screen; }\n        return bt;\n      }).filter(b => b.text || b.type === 'COPY_CODE');\n      if (btns.length) clean.push({ type: 'BUTTONS', buttons: btns });\n    }\n  }\n\n  const payload = {\n    name: name,\n    language: language,\n    category: String(r.category || 'MARKETING').toUpperCase(),\n    components: clean,\n  };\n  const pf = String(r.parameter_format || '').toUpperCase();\n  if (pf === 'POSITIONAL' || pf === 'NAMED') payload.parameter_format = pf;\n\n  out.push({\n    json: {\n      _midia: temMidia,\n      nome: name,\n      language: language,\n      header_format: headerFormat || null,\n      media_url: mediaUrl,\n      id_antigo: r.id || null,\n      payload: payload,\n    }\n  });\n}\n\nreturn out;\n"
      },
