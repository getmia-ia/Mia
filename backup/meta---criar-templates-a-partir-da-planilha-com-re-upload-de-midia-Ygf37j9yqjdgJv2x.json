    {
      "parameters": {
        "jsCode": "\n// Injeta o header_handle novo (retornado pelo upload) no payload do template\nconst ctx = $('Loop de Midia').first().json;\nconst handle = $json.h;\nif (!handle) throw new Error('Upload nao retornou handle para ' + ctx.nome + ': ' + JSON.stringify($json).slice(0, 300));\n\nconst payload = JSON.parse(JSON.stringify(ctx.payload));\nfor (const c of payload.components) {\n  if (String(c.type).toUpperCase() === 'HEADER' && c.example && c.example.header_handle) {\n    c.example.header_handle = [handle];\n  }\n}\n\nreturn [{ json: { ...ctx, handle_novo: handle, payload: payload } }];\n"
      },
