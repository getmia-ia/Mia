        5328,
        1312
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza telefone pro formato que a Meta espera: só dígitos, com 55 na frente (ex: 5511999998888)\nfunction normalizaTelefone(raw) {\n  if (!raw) return '';\n  let digitos = String(raw).replace(/\\D/g, '');\n  digitos = digitos.replace(/^0+/, '');\n\n  if (digitos.startsWith('55') && (digitos.length === 12 || digitos.length === 13)) {\n    return digitos;\n  }\n  if (digitos.length === 10 || digitos.length === 11) {\n    return '55' + digitos;\n  }\n  return digitos;\n}\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n\n  // só quem está em no_show\n  if (String(d.status).trim() !== 'no_show') continue;\n\n  // já recebeu o disparo antes? pula (coluna criada na planilha)\n  const jaDisparou = d.disparo_no_show === true || String(d.disparo_no_show).toLowerCase() === 'true';\n  if (jaDisparou) continue;\n\n  const telefone = normalizaTelefone(d.whatsapp || d.telefone);\n  const nome = (d.cliente_nome || 'Cliente').trim();\n  if (!telefone) continue;\n\n  // formata a data/hora da call pra ficar legível no template (ex: 31/07 às 15h00)\n  let dtFormatada = '';\n  if (d.dt_call) {\n    const dt = new Date(d.dt_call);\n    if (!isNaN(dt)) {\n      const dia = String(dt.getDate()).padStart(2, '0');\n      const mes = String(dt.getMonth() + 1).padStart(2, '0');\n      const hora = String(dt.getHours()).padStart(2, '0');\n      const min = String(dt.getMinutes()).padStart(2, '0');\n      dtFormatada = `${dia}/${mes} às ${hora}h${min}`;\n    }\n  }\n\n  out.push({\n    json: {\n      row_number: d.row_number, // usado depois pra bater na linha certa na hora de atualizar\n      id: d.id,\n      nome_cliente: nome,\n      dt_call_formatada: dtFormatada,\n      telefone,\n      mailing_id: d.mailing_id,\n      dono_do_lead: d.dono_do_lead,\n      dt_call: d.dt_call\n    }\n  });\n}\n\nreturn out;"
      },
