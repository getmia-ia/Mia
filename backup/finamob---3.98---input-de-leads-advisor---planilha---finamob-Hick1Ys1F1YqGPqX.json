    {
      "parameters": {
        "jsCode": "// Monta o payload no mesmo formato que o cenário do Make envia para o getmailin.php\nconst item = $input.item.json;\n\nfunction trimStr(v) {\n  return (v ?? '').toString().trim();\n}\n\n// Padroniza telefone BR para o formato +55DDD9NUMERO (ex: +5511987654321)\nfunction formatPhoneBR(v) {\n  let digits = (v ?? '').toString().replace(/\\D/g, '');\n\n  // remove zeros de discagem à esquerda (ex: 0055..., 011...)\n  digits = digits.replace(/^0+/, '');\n\n  // se já vier com o DDI 55 (12 ou 13 dígitos: 55+DDD+numero), remove pra normalizar só o número local\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  // agora \"digits\" deve ser DDD + numero (10 dígitos sem o 9, ou 11 já com o 9)\n  if (digits.length === 10) {\n    const ddd = digits.slice(0, 2);\n    const numero = digits.slice(2);\n    digits = ddd + '9' + numero;\n  }\n\n  if (digits.length !== 11) {\n    // não foi possível normalizar com confiança - não grava telefone errado\n    return '';\n  }\n\n  return '+55' + digits;\n}\n\nconst email = trimStr(item.Email).toLowerCase();\nconst phone = formatPhoneBR(item.Telefone);\nconst nome = trimStr(item.Nome);\n\nif (!email && !phone) {\n  // Sem email e sem telefone o lead não é rastreável no CRM -> pula\n  return null;\n}\n\nreturn {\n  json: {\n    first_name: nome,\n    phone: phone,\n    email: email,\n    campanha: 'Institucional',\n    campanhas: trimStr(item.campanhas),\n    conjunto_anuncios: trimStr(item.conjunto_anuncios),\n    anuncios: trimStr(item.anuncios),\n    produtos_tag: 'ADVISOR',\n    status_plano_acao: 'encaminhar advisor',\n    plano_de_acao: 'encaminhar advisor',\n    lead_origem: 'Tráfego',\n    empresa: trimStr(item.Incorporadora),\n    cargo: trimStr(item.Incorporador)\n  }\n};"
      },
