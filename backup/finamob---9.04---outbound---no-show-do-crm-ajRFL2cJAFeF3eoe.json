    {
      "parameters": {
        "jsCode": "// Um item com a lista de ids (inteiros vindos do nosso banco) para uma única consulta no CRM.\nconst ids = [...new Set($input.all().map(i => Number(i.json.mailing_id)).filter(Number.isInteger))];\nreturn [{ json: { ids: ids.join(',') } }];"
      },
      "id": "2eea594c-d5f7-4b9b-92f3-85b8bb303694",
      "name": "Ids dos mailings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        64
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Contato outbound em reunião cuja call mais recente (por telefone) está em no_show.\n-- id = mailing_id, que é como o contato outbound guarda o vínculo com o CRM.\nSELECT DISTINCT cp.mailing_id AS id\nFROM calls_pipeline cp\nWHERE cp.mailing_id IN ({{ $json.ids }})\n  AND cp.status = 'no_show'\n  AND cp.lixeira = 0\n  AND NOT EXISTS (\n      SELECT 1 FROM calls_pipeline x\n      WHERE x.lixeira = 0\n        AND x.id > cp.id\n        AND x.telefone = cp.telefone\n  );",
        "options": {}
      },
      "id": "388e8cf2-eacd-4680-9dbd-beb91f235943",
      "name": "No-show no CRM",
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        656,
        64
      ],
      "credentials": {
        "mySql": {
          "id": "8ItpiHe2joMjz6qf",
          "name": "Finamob database"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "2edd6265-301e-456a-aa5d-d0bdbd251c38",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2bc46a9-74ae-435a-a9b2-d5c3858a4fd0",
      "name": "Achou no-show?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ids: '{' + $input.all().map(i => Number(i.json.id)).join(',') + '}' } }];"
      },
      "id": "13fd6de1-c342-48cb-afde-9273965a484b",
      "name": "Ids no-show",
      "type": "n8n-nodes-base.code",
