      "parameters": {
        "jsCode": "function normalizarTelefone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  const ddd = digits.slice(0, 2);\n  let numero = digits.slice(2);\n\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  return `55${ddd}${numero}`;\n}\n\nconst body = $input.first().json.body;\n\nconst alerta = body.alerta;\nconst organizacao = body.organizacao;\n\nconst participantes = (body.participantes || []).map(p => ({\n  ...p,\n  nome: (p.nome || '').trim(),\n  telefone_normalizado: normalizarTelefone(p.telefone)\n}));\n\n// Estrutura varia conforme o tipo de alerta\n// lead_novo -> body.lead\n// planejador_assumiu_lead -> body.dados.lead e body.dados.planejador\nconst leadRaw = body.lead || (body.dados && body.dados.lead) || null;\nconst planejadorRaw = (body.dados && body.dados.planejador) || null;\n\nconst lead = leadRaw ? {\n  ...leadRaw,\n  telefone_normalizado: normalizarTelefone(leadRaw.telefone)\n} : null;\n\nconst planejador = planejadorRaw || null;\n\nreturn [{\n  json: {\n    alerta,\n    organizacao,\n    lead,\n    planejador,\n    participantes\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
