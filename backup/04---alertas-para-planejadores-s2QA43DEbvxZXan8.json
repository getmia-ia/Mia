        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst nomeParticipante = item.participantes.nome;\nconst telefoneParticipante = item.participantes.telefone_normalizado;\nconst nomeOrganizacao = item.organizacao.nome;\nconst nomeLead = item.lead.nome;\n\nconst telefoneLeadExibicao = item.lead.telefone_normalizado.replace(/^55/, '');\n\nreturn {\n  json: {\n    telefone: telefoneParticipante,\n    template_name: \"novo_lead_organizacao\",\n    param_0: nomeParticipante,\n    param_1: nomeOrganizacao,\n    param_2: nomeLead,\n    param_3: telefoneLeadExibicao\n  }\n};"
