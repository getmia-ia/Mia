  "name": "09 - Aviso de Ticket Aguardando Validação",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ticket-aguardando-validacao",
        "options": {}
      },
      "id": "a0a16e2c-3aa3-4660-a3c8-15fbd598f4c1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -336,
        0
      ],
      "webhookId": "34b1dc42-1712-43ce-9d23-f973053b6b8e"
    },
    {
      "parameters": {
        "jsCode": "function normalizarTelefone(raw) {\n  if (!raw) return null;\n  let digits = String(raw).replace(/\\D/g, '');\n\n  if (digits.startsWith('55') && (digits.length === 12 || digits.length === 13)) {\n    digits = digits.slice(2);\n  }\n\n  const ddd = digits.slice(0, 2);\n  let numero = digits.slice(2);\n\n  if (numero.length === 8) {\n    numero = '9' + numero;\n  }\n\n  return `55${ddd}${numero}`;\n}\n\nconst body = $input.first().json.body;\nconst cliente = body.cliente;\nconst ticket = body.ticket;\n\nreturn [{\n  json: {\n    telefone: normalizarTelefone(cliente.telefone),\n    nome: cliente.nome,\n    template_name: \"aviso_ticket_validacao\",\n    param_0: cliente.nome,\n    param_1: ticket.protocol,\n    mensagem_completa: `Olá ${cliente.nome}! O chamado #${ticket.protocol} foi atualizado e está aguardando sua validação. Por favor, confirme se o problema foi resolvido.`\n  }\n}];"
      },
      "id": "06f3658f-fa2e-4978-8fbd-59638dac851f",
      "name": "Montar Mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v22.0/928381500368600/messages",
        "authentication": "***REMOVIDO***",
        "genericAuthType": "***REMOVIDO***",
        "sendHeaders": "***REMOVIDO***",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.telefone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"{{ $json.template_name }}\",\n    \"language\": { \"code\": \"pt_BR\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": {{ \n          JSON.stringify(\n            [\n              { \"type\": \"text\", \"text\": $json.param_0},\n              { \"type\": \"text\", \"text\": $json.param_1}\n            ].filter(p => p.text && p.text.trim() !== \"\")\n          )\n        }}\n      }\n    ]\n  }\n}",
        "options": {}
      },
