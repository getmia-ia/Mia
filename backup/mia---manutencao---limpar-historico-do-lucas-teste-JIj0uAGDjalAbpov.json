    {
      "id": "26b40072-ae05-462e-95c4-f4c93bc53406",
      "name": "Telefone do teste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const c = $input.first().json;\nlet contatos = c.social_media && c.social_media.contacts;\nif (typeof contatos === 'string') { try { contatos = JSON.parse(contatos); } catch { contatos = []; } }\nif (!Array.isArray(contatos)) contatos = [];\nconst last8 = v => String(v || '').replace(/\\D/g, '').slice(-8);\nconst chaves = [...new Set([c.whatsapp, c.phone, ...contatos.map(x => x && x.whatsapp)].map(last8).filter(k => k.length === 8))];\nif (chaves.length !== 1) throw new Error('Esperava 1 telefone no Lucas Teste, achei ' + chaves.length + ': ' + chaves.join(', '));\nreturn [{ json: { nome: c.name, whatsapp: c.whatsapp, phone: c.phone, final8: chaves[0] } }];"
      }
    },
    {
      "id": "66e3bd9c-2ecb-4304-8bc2-dcf2bdd0f02f",
      "name": "Histórico desse telefone",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        672,
        0
      ],
      "parameters": {
        "operation": "getAll",
        "tableId": "mia-historico_mensagens",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "nome_app",
              "condition": "eq",
              "keyValue": "SDR-MIA"
            },
            {
              "keyName": "telefone",
              "condition": "like",
              "keyValue": "={{ '%' + $json.final8 }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "FsQeUlxQ7Q6O8mbE",
          "name": "MIA - Supabase"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "7f8d9f31-e75e-4d96-8122-d0fb9e48d9c8",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "const tel = $('Telefone do teste').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst nomes = [...new Set(rows.map(r => r.nome_usuario))];\nconst telefones = [...new Set(rows.map(r => r.telefone))];\nreturn [{ json: { cliente: tel, linhas: rows.length, nomes, telefones, primeira: rows.length ? rows.map(r=>r.created_at).sort()[0] : null } }];"
      }
    }
  ],
