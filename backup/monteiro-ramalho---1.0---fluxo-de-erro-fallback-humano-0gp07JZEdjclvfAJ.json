          "jsCode": "function buscarValor(obj, chaves, depth = 0) {\n  if (!obj || typeof obj !== 'object' || depth > 10) return null;\n  for (const chave of chaves) {\n    if (typeof obj[chave] === 'string' && obj[chave].trim() !== '') return obj[chave];\n  }\n  for (const key of Object.keys(obj)) {\n    const found = buscarValor(obj[key], chaves, depth + 1);\n    if (found) return found;\n  }\n  return null;\n}\n\nconst prev = $('Extrai Dados do Erro').first().json;\nlet telefone = null;\n\ntry {\n  const execData = $input.first().json;\n  const runData = execData?.data?.resultData?.runData || {};\n\n  for (const nodeName of Object.keys(runData)) {\n    const runs = runData[nodeName] || [];\n    for (const run of runs) {\n      const outputs = run?.data?.main || [];\n      for (const branch of outputs) {\n        for (const item of (branch || [])) {\n          const found = buscarValor(item?.json, ['telefone', 'botPhoneNumber']);\n          if (found) { telefone = found; break; }\n        }\n        if (telefone) break;\n      }\n      if (telefone) break;\n    }\n    if (telefone) break;\n  }\n} catch (e) {\n  telefone = null;\n}\n\nconst workflowName = prev.workflowName || '';\nlet nomeApp = 'SISTEMA';\nif (/previdenc/i.test(workflowName)) nomeApp = 'previdenciario';\nelse if (/trabalhista/i.test(workflowName)) nomeApp = 'trabalhista';\nelse if (/SDR/i.test(workflowName)) nomeApp = 'SDR-MONTEIRO';\nelse if (/entrevista/i.test(workflowName)) nomeApp = 'entrevista-peticao';\n\nreturn [{\n  json: {\n    ...prev,\n    telefone,\n    nomeApp\n  }\n}];"
        },
