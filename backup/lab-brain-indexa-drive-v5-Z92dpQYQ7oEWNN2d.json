    {
      "parameters": {
        "jsCode": "const embedData  = $input.first().json.data;\nconst ctx        = $('Code: Divide em Chunks').first().json;\nconst documentId = $('HTTP: Upsert Documento').first().json[0]?.id;\n\nif (!documentId) throw new Error('document_id não encontrado após upsert');\n\nconst rows = ctx.chunks.map((c, i) => ({\n  document_id:  documentId,\n  content:      c.content,\n  embedding:    embedData[i]?.embedding || [],\n  chunk_index:  c.chunkIndex,\n  page:         null,\n}));\n\nreturn [{\n  json: {\n    rows,\n    totalChunks:        rows.length,\n    documentId,\n    supabaseUrl:        ctx.supabaseUrl,\n    supabaseServiceKey: ctx.supabaseServiceKey,\n    fileName:           ctx.fileName,\n  }\n}];"
