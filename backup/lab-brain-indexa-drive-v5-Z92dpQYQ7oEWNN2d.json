    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst mime = f.mimeType || '';\n\n// Ignora pastas e tipos não-arquivo\nif (mime === 'application/vnd.google-apps.folder') {\n  throw new Error('SKIP: é pasta, ignorando');\n}\n\nconst EXPORTABLE_TYPES = new Set([\n  'application/vnd.google-apps.document',\n  'application/vnd.google-apps.presentation',\n  'application/vnd.google-apps.spreadsheet',\n  'application/vnd.google-apps.drawing',\n]);\nconst isGoogleNative = EXPORTABLE_TYPES.has(mime);\n\nconst extractOpMap = {\n  'application/pdf': 'pdf',\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document': 'word',\n  'application/msword': 'word',\n  'application/vnd.openxmlformats-officedocument.presentationml.presentation': 'word',\n  'application/vnd.ms-powerpoint': 'word',\n  'text/plain': 'text',\n  'text/markdown': 'text',\n  'text/x-markdown': 'text',\n};\nconst extractOp = isGoogleNative ? 'pdf' : (extractOpMap[mime] || 'text');\n\nconst skipTypes = ['image/jpeg','image/png','image/gif','image/webp','video/mp4','audio/mpeg'];\nif (skipTypes.includes(mime)) {\n  throw new Error('SKIP: tipo não suportado: ' + mime);\n}\n\nreturn [{\n  json: {\n    ...f,\n    isGoogleNative,\n    extractOp,\n    driveFileId:        f.id,\n    driveModifiedAt:    f.modifiedTime,\n    fileName:           f.name,\n    mimeType:           mime,\n    driveFolderWatchId: '1WIjp8kdnVIMmt2yBSgoHYSvxvcfGEK3_',\n    supabaseUrl:        'https://alrnajijumqvxzmogwpy.supabase.co',\n    supabaseServiceKey: '***REMOVIDO***',\n  }\n}];"
