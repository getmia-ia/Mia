    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.text || '';\nconst cfg = $('Code: Classifica Arquivo').first().json;\n\nfunction stripMarkdown(txt) {\n  return txt\n    .replace(/^#{1,6}\\s+/gm, '')\n    .replace(/\\*\\*(.+?)\\*\\*/g, '$1')\n    .replace(/\\*(.+?)\\*/g, '$1')\n    .replace(/_{2}(.+?)_{2}/g, '$1')\n    .replace(/`{3}[\\s\\S]*?`{3}/gm, '')\n    .replace(/`(.+?)`/g, '$1')\n    .replace(/^\\s*[-*+]\\s+/gm, '')\n    .replace(/^\\s*\\d+\\.\\s+/gm, '')\n    .replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, '$1')\n    .replace(/!\\[.*?\\]\\([^)]+\\)/g, '')\n    .replace(/^>\\s*/gm, '')\n    .replace(/^---+$/gm, '')\n    .trim();\n}\n\nconst isMarkdown = /\\.(md|markdown)$/i.test(cfg.fileName);\n\nconst cleaned = rawText\n  .replace(/\\r\\n/g, '\\n')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .replace(/[ \\t]{2,}/g, ' ')\n  .trim();\n\nconst text = isMarkdown ? stripMarkdown(cleaned) : cleaned;\n\nif (text.length < 80) {\n  throw new Error('SKIP: texto muito curto — ' + cfg.fileName);\n}\n\nconst CHUNK_SIZE = 800;\nconst OVERLAP   = 120;\n\nconst chunks = [];\nlet start = 0;\nwhile (start < text.length) {\n  const end     = Math.min(start + CHUNK_SIZE, text.length);\n  const content = text.slice(start, end).trim();\n  if (content.length > 40) chunks.push({ content, chunkIndex: chunks.length });\n  if (end >= text.length) break;\n  start += CHUNK_SIZE - OVERLAP;\n}\n\nreturn [{\n  json: {\n    chunks,\n    totalChunks:        chunks.length,\n    driveFileId:        cfg.driveFileId,\n    driveModifiedAt:    cfg.driveModifiedAt,\n    fileName:           cfg.fileName,\n    mimeType:           cfg.mimeType,\n    driveFolderWatchId: cfg.driveFolderWatchId,\n    supabaseUrl:        cfg.supabaseUrl,\n    supabaseServiceKey: cfg.supabaseServiceKey,\n  }\n}];"
      },
