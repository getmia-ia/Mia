    {
      "parameters": {
        "method": "POST",
        "url": "=https://monteiroramalho.getmia.com.br/api/public/ocr-doc-peticao-callback",
        "sendHeaders": "***REMOVIDO***",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
