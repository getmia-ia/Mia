      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT\n  COALESCE(m.status_plano_acao, '')            AS status_anterior,\n  COALESCE(CAST(m.produtos_tag AS CHAR), '')   AS produtos_tag,\n  COALESCE(CAST(m.dono_do_lead AS CHAR), '')   AS dono_do_lead,\n  COALESCE(CAST(m.id AS CHAR), '')             AS mailing_id\nFROM (SELECT 1) base\nLEFT JOIN (\n  SELECT *\n  FROM mailing\n  WHERE whatsapp IN (\n    \"{{ (() => { const raw = String($('When Executed by Another Workflow').first().json.phone || ''); let p = raw.replace(/\\D/g,''); if (p.startsWith('55')) p = p.slice(2); const ddd = p.slice(0,2); const num = p.slice(2); const com9 = num.length === 8 ? '9' + num : num; return com9.length === 9 ? `(${ddd}) ${com9.slice(0,5)}-${com9.slice(5)}` : `(${ddd}) ${com9.slice(0,4)}-${com9.slice(4)}`; })() }}\",\n    \"{{ (() => { const raw = String($('When Executed by Another Workflow').first().json.phone || ''); let p = raw.replace(/\\D/g,''); if (p.startsWith('55')) p = p.slice(2); const ddd = p.slice(0,2); const num = p.slice(2); const sem9 = (num.length === 9 && num.startsWith('9')) ? num.slice(1) : num; return `(${ddd}) ${sem9.slice(0,4)}-${sem9.slice(4)}`; })() }}\"\n  )\n  ORDER BY id DESC\n  LIMIT 1\n) m ON 1 = 1;",
          "options": {}
        },
        "type": "n8n-nodes-base.mySql",
        "typeVersion": 2.5,
        "position": [
          -944,
          496
        ],
        "id": "4f40b08b-e132-4c81-be97-57758697220b",
        "name": "Busca Status Atual",
        "retryOnFail": true,
        "waitBetweenTries": 5000,
        "maxTries": 3,
        "credentials": {
          "mySql": {
            "id": "8ItpiHe2joMjz6qf",
            "name": "Finamob database"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "// Compara o status atual do mailing com o status que a IA está pedindo.\n// Objetivo: só notificar o grupo quando houver mudança real de status.\n\nconst trigger = $('When Executed by Another Workflow').first().json;\nconst atual = $('Busca Status Atual').first().json || {};\n\nconst norm = (s) => String(s ?? '').trim().toLowerCase();\n\nconst statusAnterior = norm(atual.status_anterior);\nconst statusNovo     = norm(trigger.status_plano_acao);\nconst produtosTag    = norm(atual.produtos_tag);\nconst donoDoLead     = String(atual.dono_do_lead ?? '').trim();\n\nconst mudouStatus = statusAnterior !== statusNovo;\n\n// Guardas extras: se o lead já está marcado como Advisor / já é do dono de Parcerias,\n// não notifica de novo mesmo que o status tenha sido mexido manualmente.\nconst jaEhAdvisor   = statusAnterior === 'encaminhar advisor'   || produtosTag.includes('advisor');\nconst jaEhParcerias = statusAnterior === 'encaminhar parcerias' || donoDoLead === '217';\n\nreturn [{\n  json: {\n    ...trigger,\n    status_anterior: atual.status_anterior ?? '',\n    mailing_id: atual.mailing_id ?? '',\n    mudou_status: mudouStatus,\n    notificar_advisor:   statusNovo === 'encaminhar advisor'   && !jaEhAdvisor,\n    notificar_parcerias: statusNovo === 'encaminhar parcerias' && !jaEhParcerias\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -768,
          496
        ],
        "id": "82372181-85a1-4539-a16d-797696404b1e",
