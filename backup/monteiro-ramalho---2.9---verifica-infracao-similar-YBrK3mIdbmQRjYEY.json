    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n  json_agg(json_build_object('id', id, 'data_infracao', data_infracao, 'infracao', infracao) ORDER BY data_infracao DESC),\n  '[]'::json\n) AS infracoes_anteriores\nFROM (\n  SELECT id, data_infracao, infracao FROM notificacoes\n  WHERE condomino_id = $1\n  ORDER BY data_infracao DESC\n  LIMIT 20\n) sub;",
        "options": {
          "queryReplacement": "={{ [ $json.condomino_id ] }}"
        }
      },
