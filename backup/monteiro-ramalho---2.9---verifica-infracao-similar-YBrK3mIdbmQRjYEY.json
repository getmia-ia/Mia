    {
      "parameters": {
        "jsCode": "const dados = $('Trata os dados').first().json;\nconst tipo = dados.tipo === 'multa' ? 'multa' : 'notificacao';\n\nconst tipoLabel = tipo === 'multa' ? 'multa' : 'notificação';\nconst tipoOutro = tipo === 'multa' ? 'notificação' : 'multa';\n\nconst similares = $json.similares || [];\n\n// Nenhuma parecida: libera o agente para seguir normalmente.\nif (!similares.length) {\n  return [{\n    json: {\n      tem_similar: false,\n      resposta: `Nenhuma infração anterior de mesma natureza foi encontrada para este condômino. Pode seguir e criar a ${tipoLabel} normalmente, sem precisar avisar o usuário sobre esta verificação.`\n    }\n  }];\n}\n\nfunction formataData(valor) {\n  if (!valor) return 'sem data';\n  const iso = String(valor).split('T')[0];\n  const partes = iso.split('-');\n  if (partes.length !== 3) return iso;\n  return `${partes[2]}/${partes[1]}/${partes[0]}`;\n}\n\nconst lista = similares.map((s, i) => {\n  const texto = String(s.infracao || '').trim();\n  const resumo = texto.length > 300 ? texto.slice(0, 300) + '...' : texto;\n  return `${i + 1}. Em ${formataData(s.data_infracao)}\\n${resumo}\\nMotivo da semelhança: ${s.motivo}`;\n}).join('\\n\\n');\n\nconst quantidade = similares.length === 1\n  ? '1 notificação anterior'\n  : `${similares.length} notificações anteriores`;\n\nconst resposta = `⚠️ Possível reincidência\\n\\nEncontrei ${quantidade} deste condômino com infração de mesma natureza:\\n\\n${lista}\\n\\nComo deseja prosseguir?\\n1. Gerar a ${tipoLabel} mesmo assim\\n2. Gerar uma ${tipoOutro} com os mesmos dados`;\n\nreturn [{\n  json: {\n    tem_similar: true,\n    quantidade: similares.length,\n    resposta: resposta\n  }\n}];"
      },
