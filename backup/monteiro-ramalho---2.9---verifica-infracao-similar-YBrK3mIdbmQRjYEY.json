    {
      "parameters": {
        "jsCode": "const anteriores = $('Busca Infrações Anteriores').first().json.infracoes_anteriores || [];\nconst similaresIds = ($json.similares || []).map(s => ({ id: s.id, motivo: s.motivo }));\n\nconst similares = similaresIds\n  .map(s => {\n    const original = anteriores.find(a => a.id === s.id);\n    if (!original) return null;\n    return {\n      id: original.id,\n      data_infracao: original.data_infracao,\n      infracao: original.infracao,\n      motivo: s.motivo\n    };\n  })\n  .filter(Boolean);\n\nreturn [{\n  json: {\n    tem_similar: similares.length > 0,\n    similares\n  }\n}];"
      },
