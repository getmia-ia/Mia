    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"similares\": [\n    { \"id\": \"uuid-exemplo\", \"motivo\": \"Ambas tratam de perturbação do sossego em horário noturno.\" }\n  ]\n}",
        "autoFix": true
      },
      "id": "e767de56-77d1-4dad-a0c8-59a7d57b3c9d",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        448,
        336
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1e2f3a4-0005-4a1a-8a1a-000000000005",
              "name": "similares",
              "type": "array",
              "value": "={{ $json.output.similares }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f2bdf1d6-79bb-4f81-9dfb-7b563ccdbf6f",
      "name": "Normaliza Saída LLM",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        704,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const anteriores = $('Busca Infrações Anteriores').first().json.infracoes_anteriores || [];\nconst similaresIds = ($json.similares || []).map(s => ({ id: s.id, motivo: s.motivo }));\n\nconst similares = similaresIds\n  .map(s => {\n    const original = anteriores.find(a => a.id === s.id);\n    if (!original) return null;\n    return {\n      id: original.id,\n      data_infracao: original.data_infracao,\n      infracao: original.infracao,\n      motivo: s.motivo\n    };\n  })\n  .filter(Boolean);\n\nreturn [{\n  json: {\n    tem_similar: similares.length > 0,\n    similares\n  }\n}];"
      },
      "id": "6831653a-f7da-4838-821a-0fc84555045b",
