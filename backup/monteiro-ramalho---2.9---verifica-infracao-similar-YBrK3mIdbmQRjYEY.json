      "parameters": {
        "jsCode": "return items.map(item => {\n  let data = item.json.body || item.json;\n\n  const obrigatorios = ['condomino_id', 'infracao'];\n  for (const campo of obrigatorios) {\n    if (data[campo] === undefined || data[campo] === null || String(data[campo]).trim() === '') {\n      throw new Error(`Campo obrigatório \"${campo}\" não informado.`);\n    }\n  }\n\n  return {\n    json: {\n      condomino_id: data.condomino_id,\n      infracao: data.infracao\n    }\n  };\n});"
      },
