    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  let data = item.json;\n\n  // Quando vem do sistema (plataforma), os dados chegam dentro de \"body\".\n  // Essa checagem vem primeiro porque o nó de webhook sempre inclui um campo\n  // \"query\" (os parâmetros da URL), normalmente vazio — se olhassemos o \"query\"\n  // antes, toda chamada do sistema cairia no caminho errado.\n  if (data.body !== undefined && data.body !== null) {\n    data = data.body;\n\n  // Quando a IA chama isso como ferramenta, os dados chegam dentro de \"query\",\n  // em formato de texto JSON (ou já como objeto, dependendo da versão).\n  } else if (typeof data.query === 'string' && data.query.trim() !== '') {\n    data = JSON.parse(data.query);\n\n  } else if (data.query && typeof data.query === 'object' && data.query.condomino_id) {\n    data = data.query;\n  }\n\n  const obrigatorios = ['condomino_id', 'infracao'];\n  for (const campo of obrigatorios) {\n    if (data[campo] === undefined || data[campo] === null || String(data[campo]).trim() === '') {\n      throw new Error(`Campo obrigatório \"${campo}\" não informado.`);\n    }\n  }\n\n  // Se não disserem o tipo, assumimos notificação.\n  const tipo = String(data.tipo || 'notificacao').toLowerCase() === 'multa'\n    ? 'multa'\n    : 'notificacao';\n\n  return {\n    json: {\n      condomino_id: data.condomino_id,\n      infracao: data.infracao,\n      tipo: tipo\n    }\n  };\n});"
      },
