        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Agrupa em lotes de 50: a Graph API lê múltiplos objetos numa só chamada (?ids=).\nconst ids = $input.all().map(i => i.json.ad_id);\nconst lotes = [];\nfor (let i = 0; i < ids.length; i += 50) lotes.push(ids.slice(i, i + 50));\nreturn lotes.map((l, i) => ({ json: { lote: i + 1, total: lotes.length, ids: l.join(',') } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        432
      ],
      "id": "ba0bfb45-0cb6-4db4-9692-7cc0e146c0f1",
      "name": "Divide em Lotes de 50"
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        672,
        432
      ],
      "id": "96801641-08c1-46ae-a713-1f3a23ad336a",
      "name": "Loop Lotes"
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v23.0/?ids={{ $json.ids }}&fields=id,status,effective_status,creative{instagram_permalink_url,thumbnail_url}",
        "authentication": "***REMOVIDO***",
        "nodeCredentialType": "facebookGraphApi",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        912,
        544
      ],
      "id": "f87d3840-1093-4d8e-81df-923c2ab16180",
      "name": "Meta Criativos",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 4000,
      "credentials": {
        "facebookGraphApi": {
          "id": "bqvhO7I9HxNLrUbM",
          "name": "app-mia-finamob"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// A resposta de ?ids= vem como objeto chaveado pelo id.\nconst rows = [];\nfor (const item of $input.all()) {\n  for (const o of Object.values(item.json)) {\n    if (!o || typeof o !== 'object' || !o.id) continue;\n    rows.push({\n      ad_id: String(o.id),\n      permalink_url: o.creative?.instagram_permalink_url ?? null,\n      thumbnail_url: o.creative?.thumbnail_url ?? null,\n      status_ad: o.status ?? null,\n      status_efetivo: o.effective_status ?? null,\n    });\n  }\n}\nreturn [{ json: { linhas: rows.length, payload: JSON.stringify(rows) } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        544
      ],
      "id": "e7ac0380-6b2b-476f-8bb1-143a4016b3ed",
      "name": "Normaliza Criativos"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Nunca apaga link existente. Conta tentativa para não reconsultar eternamente\n-- anúncio que simplesmente não tem permalink de Instagram.\nupdate ads_anuncio a set\n  permalink_url        = coalesce(x.permalink_url, a.permalink_url),\n  thumbnail_url        = coalesce(x.thumbnail_url, a.thumbnail_url),\n  status_ad            = coalesce(x.status_ad,      a.status_ad),\n  status_efetivo       = coalesce(x.status_efetivo, a.status_efetivo),\n  criativo_em          = case when x.permalink_url is not null then now() else a.criativo_em end,\n  criativo_tentativas  = a.criativo_tentativas + 1,\n  atualizado_em        = now()\nfrom jsonb_to_recordset($1::jsonb) as x(\n  ad_id text, permalink_url text, thumbnail_url text,\n  status_ad text, status_efetivo text\n)\nwhere a.ad_id = x.ad_id\nreturning a.ad_id;",
        "options": {
          "queryReplacement": "={{ [$json.payload] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1344,
        544
      ],
      "id": "2c34c8c9-d2cb-475f-9fe1-8eb10f13d054",
      "name": "Atualiza Dimensao",
      "credentials": {
        "postgres": {
          "id": "AnkjyUs1zUuCvnoa",
          "name": "Finamob - Postgres"
        }
      }
    },
