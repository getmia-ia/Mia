    {
      "parameters": {
        "jsCode": "if (!nome || !String(nome).trim() || !telefone) {\n  descartados.push({\n    json: {\n      _valido: false,\n      motivo: !telefone ? 'telefone_invalido_ou_ausente' : 'nome_ausente',\n      nome_identificado: nome ? String(nome).trim() : null,\n      telefone_identificado: encontrarCampo(row, aliases.telefone) || null,\n      linha_original: row\n    }\n  });\n  continue;\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        288
      ],
      "id": "f7837b3a-595e-4129-87c1-0b003d112c70",
      "name": "Normalizador de Colunas"
    },
    {
      "parameters": {
        "jsCode": "function sufixoTelefone(valor) {\n  if (!valor) return null;\n  const digitos = String(valor).replace(/\\D/g, '');\n  return digitos.length >= 8 ? digitos.slice(-8) : null;\n}\n\nconst tabelaCompleta = $('Buscar Tabela Completa').all().map(i => i.json);\n\nconst mapaTelefone = {};\nconst mapaEmail = {};\nfor (const linha of tabelaCompleta) {\n  const sufixo = sufixoTelefone(linha.telefone);\n  if (sufixo) mapaTelefone[sufixo] = linha;\n  if (linha.email) mapaEmail[linha.email] = linha;\n}\n\nfunction normalizarComparacao(valor) {\n  return (valor === undefined || valor === null) ? '' : String(valor).trim();\n}\n\nconst donoDoEmailNoLote = {};\nconst resultado = [];\n\nfor (const item of items) {\n  const original = item.json;\n  const sufixoOriginal = sufixoTelefone(original.telefone);\n  const existente = sufixoOriginal ? mapaTelefone[sufixoOriginal] : null;\n  const existePorTelefone = !!existente;\n\n  let emailFinal = original.email ? original.email.trim() : original.email;\n\n  if (emailFinal) {\n    const donoNaTabela = mapaEmail[emailFinal];\n    const ehDonoLegitimoNaTabela = existente && donoNaTabela && sufixoTelefone(donoNaTabela.telefone) === sufixoOriginal;\n    if (donoNaTabela && !ehDonoLegitimoNaTabela) {\n      emailFinal = null;\n    }\n  }\n\n  if (emailFinal) {\n    const donoNoLote = donoDoEmailNoLote[emailFinal];\n    if (donoNoLote && donoNoLote !== original.telefone) {\n      emailFinal = null;\n    } else {\n      donoDoEmailNoLote[emailFinal] = original.telefone;\n    }\n  }\n\n  let precisaAtualizar = true;\n  if (existePorTelefone) {\n    precisaAtualizar =\n      normalizarComparacao(existente.nome) !== normalizarComparacao(original.nome) ||\n      normalizarComparacao(existente.cargo) !== normalizarComparacao(original.cargo) ||\n      normalizarComparacao(existente.email) !== normalizarComparacao(emailFinal) ||\n      normalizarComparacao(existente.empresa_nome) !== normalizarComparacao(original.empresa_nome) ||\n      normalizarComparacao(existente.etapa) !== normalizarComparacao(original.etapa);\n  }\n\n  resultado.push({\n    json: {\n      nome: original.nome,\n      telefone: original.telefone,\n      cargo: original.cargo,\n      email: emailFinal,\n      empresa_nome: original.empresa_nome,\n      etapa: original.etapa,\n      existe_por_telefone: existePorTelefone,\n      precisa_atualizar: precisaAtualizar\n    }\n  });\n}\n\nreturn resultado;"
      },
