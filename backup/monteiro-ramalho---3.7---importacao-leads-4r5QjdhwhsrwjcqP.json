    {
      "parameters": {
        "jsCode": "const descartadosRaw = $('Válido?').all().filter(i => i.json._valido === false);\n\nconst descartados = descartadosRaw.map(i => ({\n  nome: i.json.nome_identificado || '(não identificado)',\n  telefone: i.json.telefone_identificado || '(não identificado)',\n  motivo: i.json.motivo === 'telefone_invalido_ou_ausente'\n    ? 'Telefone ausente ou inválido'\n    : 'Nome ausente'\n}));\n\nreturn [{\n  json: {\n    sucesso: true,\n    resumo: {\n      atualizados: $('Atualizar Lead').all().length,\n      criados: $('Criar Lead').all().length,\n      ignorados: descartados.length\n    },\n    leads_ignorados: descartados\n  }\n}];"
