      "id": "6bd0dff4-15e9-4cb5-bd0d-25a609102822",
      "name": "É contato?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -880,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body.data;\nconst msg = body.message;\nlet vcards = [];\n\nif (msg.contactMessage) {\n  vcards = [msg.contactMessage.vcard];\n} else if (msg.contactsArrayMessage) {\n  vcards = msg.contactsArrayMessage.contacts.map(c => c.vcard);\n}\n\nfunction parseVcard(vcard) {\n  const fnMatch = vcard.match(/FN:(.+)/);\n  const waidMatch = vcard.match(/waid=(\\d+)/);\n  const telMatch = vcard.match(/TEL[^:]*:(.+)/);\n  const nome = fnMatch ? fnMatch[1].trim() : null;\n  const telefone = waidMatch ? waidMatch[1] : (telMatch ? telMatch[1].replace(/\\D/g, '') : null);\n  return { nome, telefone };\n}\n\nconst indicador = {\n  nome_indicador: body.pushName || 'Não identificado',\n  telefone_indicador: body.key.remoteJid.replace('@s.whatsapp.net', '')\n};\n\nreturn vcards\n  .map(parseVcard)\n  .filter(c => c.nome && c.telefone)\n  .map(c => ({\n    json: {\n      nome_indicado: c.nome,\n      telefone_indicado: c.telefone,\n      ...indicador,\n      data_hora: new Date().toISOString()\n    }\n  }));"
      },
      "id": "0fa1ef19-dbdb-4e69-9b10-7423cb3a5321",
      "name": "Parse vCard + Indicador",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        192
      ]
    },
